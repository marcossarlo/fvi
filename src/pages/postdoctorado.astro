---
import ProgramShowcase from '~/components/widgets/ProgramShowcase.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';
import type { ItemFeaturedProgram } from '~/types';

const metadata = {
  title: 'Postdoctorado | Programas postdoctorales en medio ambiente | Fondo Verde Institute',
  description:
    'Conoce la oferta de postdoctorados de Fondo Verde Institute: ciencias aplicadas al medio ambiente, sostenibilidad, educación ambiental, gobernanza, peritaje y sistemas de gestión.',
  keywords:
    'postdoctorado, postdoc, ciencias aplicadas al medio ambiente, ciencias de la sostenibilidad, educación ambiental, gobernanza ambiental, peritaje ambiental, sistemas de gestión medioambiental, Fondo Verde Institute',
};

const postdoctoradoStartDate = '2 de diciembre de 2026';

const postdoctoradoPrograms: ItemFeaturedProgram[] = [
  {
    image: '~/assets/images/postdocs/fvi-postdoc-ciencias-aplicadas-medio-ambiente.webp',
    title: '<span class="text-primary">Postdoctorado en</span> Ciencias Aplicadas al Medio Ambiente',
    date: postdoctoradoStartDate,
    description:
      'Impulsa la producción científica sobre sustentabilidad ambiental, tecnologías limpias y transición hacia una economía sostenible.',
    button: {
      text: 'Ver programa',
      href: '/postdoctorado/ciencias-aplicadas-medio-ambiente',
      variant: 'primary',
    },
  },
  {
    image: '~/assets/images/postdocs/fvi-postdoc-ciencias-educacion-ambiental.webp',
    title: '<span class="text-primary">Postdoctorado en</span> Ciencias de la Educación Ambiental',
    date: postdoctoradoStartDate,
    description:
      'Fortalece la investigación y la práctica pedagógica para promover educación científica y cultura ambiental.',
    button: {
      text: 'Ver programa',
      href: '/postdoctorado/ciencias-educacion-ambiental',
      variant: 'primary',
    },
  },
  {
    image: '~/assets/images/postdocs/fvi-postdoc-ciencias-sostenibilidad.webp',
    title: '<span class="text-primary">Postdoctorado en</span> Ciencias de la Sostenibilidad',
    date: postdoctoradoStartDate,
    description: 'Desarrolla proyectos sobre ODS, cambio climático y políticas ambientales con enfoque internacional.',
    button: {
      text: 'Ver programa',
      href: '/postdoctorado/ciencias-sostenibilidad',
      variant: 'primary',
    },
  },
  {
    image: '~/assets/images/postdocs/fvi-postdoc-gestion-gobernanza-proyectos-ambientales.webp',
    title: '<span class="text-primary">Postdoctorado en</span> Gestión y Gobernanza de Proyectos Ambientales',
    date: postdoctoradoStartDate,
    description:
      'Profundiza en liderazgo, gobernanza y gestión de proyectos para impulsar el cambio de paradigma hacia la sustentabilidad.',
    button: {
      text: 'Ver programa',
      href: '/postdoctorado/gestion-gobernanza-proyectos-ambientales',
      variant: 'primary',
    },
  },
  {
    image: '~/assets/images/postdocs/fvi-postdoc-peritaje-judicial-delitos-ambientales.webp',
    title: '<span class="text-primary">Postdoctorado en</span> Peritaje Judicial en materia de delitos ambientales',
    date: postdoctoradoStartDate,
    description:
      'Forma especialistas en pericia científica, valoración de daños y litigios ambientales con proyección iberoamericana.',
    button: {
      text: 'Ver programa',
      href: '/postdoctorado/peritaje-judicial-delitos-ambientales',
      variant: 'primary',
    },
  },
  {
    image: '~/assets/images/postdocs/fvi-postdoc-sistemas-gestion-medioambiental.webp',
    title: '<span class="text-primary">Postdoctorado en</span> Sistemas de Gestión Medioambiental',
    date: postdoctoradoStartDate,
    description: 'Profundiza en auditoría ambiental, ISO 14001 y sostenibilidad corporativa aplicada a organizaciones.',
    button: {
      text: 'Ver programa',
      href: '/postdoctorado/sistemas-gestion-medioambiental',
      variant: 'primary',
    },
  },
  {
    image: '~/assets/images/postdocs/fvi-postdoc-sistemas-gestion-seguridad-salud-trabajo.webp',
    title:
      '<span class="text-primary">Postdoctorado en</span> Sistemas de Gestión de la Seguridad y Salud en el trabajo',
    date: postdoctoradoStartDate,
    description: 'Investiga prevención de riesgos, salud ocupacional y auditoría bajo la norma ISO 45001.',
    button: {
      text: 'Ver programa',
      href: '/postdoctorado/sistemas-gestion-seguridad-salud-trabajo',
      variant: 'primary',
    },
  },
];
---

<Layout metadata={metadata} showSecondaryNav={false}>
  <Hero
    tagline="PostDoc"
    subtitle="El Programa de Postdoctorado tiene por objetivo divulgar y fortalecer la producción de trabajos de relevancia científica en temas de sustentabilidad ambiental, dirigido a doctores de toda Iberoamérica y de cualquier disciplina."
    actions={[
      {
        variant: 'primary',
        text: 'Ver programas',
        href: '#programas',
        icon: 'tabler:school',
        class:
          '!bg-primary !border-primary !text-white hover:!bg-secondary hover:!border-secondary transition-colors duration-300',
      },
      {
        variant: 'secondary',
        text: 'Leer presentación',
        href: '#presentacion',
        icon: 'tabler:file-description',
        class:
          '!bg-transparent !text-white !border-[1px] !border-solid !border-white/50 hover:!bg-white/10 hover:!text-white hover:!border-white transition-all duration-300',
      },
    ]}
    image={{
      src: '~/assets/images/postdocs/fvi-postdoc-ciencias-aplicadas-medio-ambiente.webp',
      alt: 'Oferta de postdoctorados de Fondo Verde Institute',
    }}
  >
    <Fragment slot="title">
      Postdoctorado <br />
      <span class="text-secondary dark:text-accent">Programas oficiales</span>
    </Fragment>
  </Hero>

  <Features3
    id="presentacion"
    title="Presentación"
    subtitle="El postdoctorado abre nuevas perspectivas para articular estrategias de actuación en Latinoamérica, con alcance en políticas públicas y privadas, generando reflexión, co-construcción de conocimiento y propuestas concretas."
    columns={3}
    items={[
      {
        title: 'Producción científica en sustentabilidad ambiental',
        description:
          'Tiene por objetivo divulgar y fortalecer la producción de trabajos de relevancia científica en temas de sustentabilidad ambiental.',
        icon: 'tabler:microscope',
      },
      {
        title: 'Dirigido a doctores iberoamericanos',
        description:
          'Está orientado a doctores de toda Iberoamérica y de cualquier disciplina que busquen desarrollar un proyecto de investigación para responder a conflictos ambientales locales o regionales.',
        icon: 'tabler:users-group',
      },
      {
        title: 'Nuevas perspectivas de actuación',
        description:
          'Complementa la formación con cuestiones ambientales actuales aparecidas recientemente en el escenario científico y fortalece bases para un nuevo paradigma del ambiente.',
        icon: 'tabler:world-search',
      },
    ]}
  />

  <Features3
    id="estructura"
    title="Estructura del Programa"
    subtitle="El Programa de Postdoctorado tiene una duración mínima de 6 meses y máxima de 1 año, y consiste en la realización de un plan de actividades cuyo resultado debe ser la publicación de un artículo arbitrado por dos jurados, uno de ellos internacional."
    columns={3}
    items={[
      {
        title: 'Plan de Trabajo Postdoctoral',
        description:
          'Define el recorrido académico y científico del postdoc bajo supervisión de un director designado para tal efecto.',
        icon: 'tabler:clipboard-list',
      },
      {
        title: 'Asignaturas de la programación',
        description:
          'Integra contenidos actualizados para fortalecer la comprensión de los problemas ambientales y sus posibles respuestas científicas.',
        icon: 'tabler:book-2',
      },
      {
        title: 'Trabajo Final de Investigación',
        description:
          'El TFI articula la producción original del postdoc y se acompaña de un informe final avalado y una defensa formal.',
        icon: 'tabler:flask',
      },
      {
        title: 'Informe final avalado',
        description:
          'Documenta el cumplimiento de las actividades y consolida los resultados obtenidos durante el proceso postdoctoral.',
        icon: 'tabler:file-check',
      },
      {
        title: 'Defensa del TFI',
        description:
          'Cierra el proceso con la presentación y evaluación del trabajo final ante la instancia académica correspondiente.',
        icon: 'tabler:certificate-2',
      },
    ]}
  />

  <section id="programas" class="relative py-20 md:py-24 overflow-hidden">
    <div
      class="absolute inset-0 bg-gradient-to-b from-white via-white to-blue-50/80 dark:from-slate-950 dark:via-page dark:to-pageDark"
    >
    </div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10 md:mb-14">
        <span
          class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-4 py-2 text-sm font-semibold uppercase tracking-[0.2em] text-primary dark:text-accent"
        >
          Postdoctorados disponibles
        </span>
        <h2 class="mt-5 text-3xl md:text-4xl font-bold tracking-tighter text-default dark:text-white">
          Conoce la oferta PostDoc de Fondo Verde
        </h2>
        <p class="mt-4 text-base md:text-lg text-muted dark:text-slate-300 max-w-2xl">
          Cada programa articula investigación avanzada, acompañamiento académico y una línea de especialización clara
          para doctores que buscan una formación postdoctoral de alto nivel.
        </p>
      </div>

      <ProgramShowcase id="programas-listado" tagline="Programas PostDoc" columns={2} items={postdoctoradoPrograms} />
    </div>
  </section>
</Layout>
