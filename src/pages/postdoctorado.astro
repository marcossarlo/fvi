---
import ProgramShowcase from '~/components/widgets/ProgramShowcase.astro';
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';
import { programs } from '~/data/programs';
import { getProgramsByCategory } from '~/utils/programs';
import Features from '~/components/widgets/Features.astro';

const metadata = {
  title: 'Postdoctorados en Sustentabilidad Ambiental',
  description: 'Programa para doctores en Iberoamérica. Lidera proyectos de investigación en conflictos socioambientales y publica ciencia de alto impacto global.',
  keywords: 'postdoctorado en medio ambiente, investigación postdoctoral, sustentabilidad, doctores iberoamérica, publicación científica, Fondo Verde, postdoctorado',
};

const postdoctoradoPrograms = getProgramsByCategory(programs, 'postdoctorado');
---

<Layout metadata={metadata}>
  <Hero
    tagline="Presentación"
    image={{
      src: '~/assets/images/postdocs/fvi-postdoc-ciencias-aplicadas-medio-ambiente.webp',
      alt: 'Programas de Postdoctorado de Fondo Verde Institute',
    }}
  >
    <Fragment slot="title">
      Postdoctorados
      <span class="text-primary dark:text-accent"> de investigación</span>
    </Fragment>
    <Fragment slot="subtitle">
      Dirigido a doctores de toda Iberoamérica, este programa busca impulsar la producción científica de alto impacto en sustentabilidad ambiental. Desarrollarás proyectos enfocados en resolver conflictos socioambientales reales, aportando a la construcción teórica de un nuevo paradigma ecológico.<br />
      Esta experiencia te abre nuevas perspectivas para influir en políticas públicas y privadas en Latinoamérica. Te integrarás a un ecosistema de reflexión y co-creación de conocimiento, actualizando tu perfil investigador con las temáticas ambientales más recientes del escenario científico.
    </Fragment>
  </Hero>

  <Features
    id="estructura"
    tagline="Fases y Entregables"
    title="Estructura del Programa"
    subtitle="El postdoctorado tiene una duración flexible de <strong>6 a 12 meses</strong> y se desarrolla bajo la supervisión directa de un director designado. El resultado culminante de esta ruta es la <strong>publicación de un artículo científico</strong> arbitrado por dos jurados (incluyendo un par internacional)."
    columns={3}
    classes={{
      container: 'max-w-7xl',
      items: {
        panel: 'max-w-none w-full',
      },
    }}
    items={[
      {
        title: 'Planificación y Actualización',
        description:
          'La fase inicial contempla el diseño y aprobación del <strong>Plan de Trabajo Postdoctoral</strong>, complementado con el desarrollo de asignaturas estratégicas para la actualización teórica y metodológica del investigador.',
        icon: 'tabler:route',
      },
      {
        title: 'Trabajo Final de Investigación (TFI)',
        description:
          'Es el núcleo del programa. El investigador ejecuta su proyecto enfocado en generar respuestas concretas a la problemática ambiental elegida, redactando un artículo de alta relevancia científica.',
        icon: 'tabler:microscope',
      },
      {
        title: 'Evaluación y Defensa',
        description:
          'El proceso concluye con la presentación de un <strong>informe final avalado</strong> por el director y la <strong>defensa formal del TFI</strong>. Esta evaluación asegura el rigor necesario para su posterior divulgación global.',
        icon: 'tabler:award',
      },
    ]}
  />

  <ProgramShowcase id="programas-listado" tagline="Programas de Postdoctorado" columns={2} items={postdoctoradoPrograms} />
</Layout>