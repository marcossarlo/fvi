---
import ProgramShowcase from '~/components/widgets/ProgramShowcase.astro';
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';
import { programs } from '~/data/programs';
import { getProgramsByCategory } from '~/utils/programs';
import Features from '~/components/widgets/Features.astro';

const metadata = {
  title: 'Maestrías Especializadas en Medio Ambiente',
  description: 'Fórmate como líder en protección ambiental. Estudia online con flexibilidad, expande tu red global y posiciona tu carrera en gestión de la sustentabilidad.',
  keywords: 'maestría en medio ambiente, gestión ambiental, sustentabilidad, maestría online, Fondo Verde, liderazgo ambiental, protección del planeta, posgrado',
};

const maestriaPrograms = getProgramsByCategory(programs, 'maestria');
---

<Layout metadata={metadata}>
  <Hero
    tagline="Presentación"
    image={{
      src: '~/assets/images/fvi_maestrias_home.webp',
      alt: 'Programas de Maestría de Fondo Verde Institute',
    }}
  >
    <Fragment slot="title">
      Maestrías
      <span class="text-primary dark:text-accent"> oficiales</span>
    </Fragment>
    <Fragment slot="subtitle">
      Nuestros programas de maestría aspiran a ser el principal referente en la formación de profesionales en protección ambiental a nivel continental. Su estructura se basa en un enfoque moderno de planificación y gestión global, lo que te permitirá posicionarte como una figura estratégica dentro de cualquier organización comprometida con el cuidado del planeta.<br />
      Esta experiencia académica transformará tu visión profesional apoyada en tres pilares: flexibilidad, internacionalización y prestigio. Podrás equilibrar tu vida laboral y académica, trabajar los contenidos de manera autónoma y expandir tu red global para llevar tu carrera al siguiente nivel.
    </Fragment>
  </Hero>

  <Features
    id="estructura"
    tagline="Fases y Carga Lectiva"
    title="Estructura del Programa"
    subtitle="La maestría tiene una duración preestablecida de <strong>2 años (seis trimestres)</strong>, con una carga académica total fijada en <strong>90 créditos (1,440 horas lectivas)</strong>. Su progresión académica está diseñada para garantizar una sólida base teórica y su inmediata aplicación práctica a través del Proyecto Terminal."
    columns={3}
    classes={{
      container: 'max-w-7xl',
      items: {
        panel: 'max-w-none w-full',
      },
    }}
    items={[
      {
        title: 'Periodo de formación básica',
        description:
          'Abarca los primeros <strong>tres trimestres</strong>. Se imparten nueve cursos clave diseñados para otorgar al estudiante una base teórica sólida y profunda en las áreas centrales de la gestión y problemática ambiental.',
        icon: 'tabler:books',
      },
      {
        title: 'Proyecto Terminal',
        description:
          'Durante el <strong>cuarto y quinto trimestre</strong>, el enfoque se dirige íntegramente al desarrollo del Proyecto Terminal de Maestría, aplicando los conocimientos adquiridos a la investigación y resolución de retos ambientales reales.',
        icon: 'tabler:flask',
      },
      {
        title: 'Titulación y graduación',
        description:
          'En el <strong>sexto trimestre</strong>, el proceso culmina con la acreditación de la opción terminal elegida. El estudiante completa los trámites correspondientes de titulación para la obtención formal de su grado académico.',
        icon: 'tabler:certificate',
      },
    ]}
  />

  <ProgramShowcase id="programas-listado" tagline="Programas de Maestría" columns={2} items={maestriaPrograms} />
</Layout>
