---
import FeaturedPrograms from '~/components/widgets/FeaturedPrograms.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';
import type { ItemFeaturedProgram } from '~/types';

const metadata = {
  title: 'Maestrías online en medio ambiente y sostenibilidad | Fondo Verde Institute',
  description:
    'Conoce las 8 maestrías online de Fondo Verde Institute en medio ambiente, sostenibilidad, territorio, energía y gestión ambiental, con inicio el 11 de noviembre de 2026.',
  keywords:
    'maestrías, maestría online, medio ambiente, sostenibilidad, gestión ambiental, territorio, energía, Fondo Verde Institute',
};

const maestriaStartDate = '11 de noviembre de 2026';

const maestriaPrograms: ItemFeaturedProgram[] = [
  {
    image: '/images/programs/fvi_fondo-hero.jpg',
    title: '<span class="text-primary">Maestría en</span> Ciencias de la Sostenibilidad',
    date: maestriaStartDate,
    description:
      'El Desarrollo Sostenible es el paradigma de desarrollo que la región visualiza como el modelo a buscar. Es el gran reto que se plantea a la humanidad de entender y asumir un proceso de cambio y transición para alcanzar nuevas formas de producir.',
    button: {
      text: 'Leer más',
      href: '/maestria/ciencias-sostenibilidad',
      variant: 'primary',
    },
  },
  {
    image: '/images/programs/fvi_fondo-hero.jpg',
    title: '<span class="text-primary">Maestría en</span> Eficiencia Energética, Cambio Climático y Sostenibilidad',
    date: maestriaStartDate,
    description:
      'Planificar, proyectar y dirigir proyectos globales en el campo de la tecnología energética y la sostenibilidad en el complejo marco del cambio climático.',
    button: {
      text: 'Leer más',
      href: '/maestria/eficiencia-energetica-cambio-climatico-sostenibilidad',
      variant: 'primary',
    },
  },
  {
    image: '/images/programs/fvi_fondo-hero.jpg',
    title: '<span class="text-primary">Maestría en</span> Gestión de Proyectos Ambientales',
    date: maestriaStartDate,
    description:
      'El manejo del espacio, así como la gestión de los recursos naturales no pueden seguir realizándose de forma espontánea y anárquica. En este contexto los proyectos ambientales en un marco de procesos de planificación para la toma de decisiones.',
    button: {
      text: 'Leer más',
      href: '/maestria/gestion-proyectos-ambientales',
      variant: 'primary',
    },
  },
  {
    image: '/images/programs/fvi_fondo-hero.jpg',
    title: '<span class="text-primary">Maestría en</span> Hábitat, Urbanismo y Edificación Sostenible',
    date: maestriaStartDate,
    description:
      'Mejorar la resiliencia al cambio climático requiere de intervenciones en la ciudad que vayan más allá de edificaciones sostenibles y procuren acciones urbanísticas para transformar el hábitat con preceptos acordes al medio natural.',
    button: {
      text: 'Leer más',
      href: '/maestria/habitat-urbanismo-edificacion-sostenible',
      variant: 'primary',
    },
  },
  {
    image: '/images/programs/fvi_fondo-hero.jpg',
    title: '<span class="text-primary">Maestría en</span> Medio Ambiente y Responsabilidad Social',
    date: maestriaStartDate,
    description:
      'La empresa del siglo XXI exige políticas ambientales sostenibles, además de una responsabilidad social corporativa rigurosa, que satisfaga las necesidades económicas y sociales.',
    button: {
      text: 'Leer más',
      href: '/maestria/medio-ambiente-responsabilidad-social',
      variant: 'primary',
    },
  },
  {
    image: '/images/programs/fvi_fondo-hero.jpg',
    title: '<span class="text-primary">Maestría en</span> Paisaje, Patrimonio y Estudios Territoriales',
    date: maestriaStartDate,
    description:
      'Acostumbrados a ver paisajes degradados y banalizados como evidencia de una desidia en su gestión, emerge la necesidad de recuperar, transformar y crear paisajes de calidad como expresión indisociable de una correcta gestión y ordenación.',
    button: {
      text: 'Leer más',
      href: '/maestria/paisaje-patrimonio-estudios-territoriales',
      variant: 'primary',
    },
  },
  {
    image: '/images/programs/fvi_fondo-hero.jpg',
    title: '<span class="text-primary">Maestría en</span> Rehabilitación Ambiental Terrestre',
    date: maestriaStartDate,
    description:
      'La restauración ecológica es una ciencia ambiental innovadora que aplica técnicas preventivas y correctoras de la degradación del medio natural y plantea la recuperación de forma sostenible, a largo plazo.',
    button: {
      text: 'Leer más',
      href: '/maestria/rehabilitacion-ambiental-terrestre',
      variant: 'primary',
    },
  },
  {
    image: '/images/programs/fvi_fondo-hero.jpg',
    title: '<span class="text-primary">Maestría en</span> Sostenibilidad Turística y Ecoturismo',
    date: maestriaStartDate,
    description:
      'El turismo es un sector que ha crecido de manera importante en los últimos años y ha evolucionado en continua adaptación a las exigencias del presente. La toma de decisiones y la capacidad de liderazgo resultan determinantes ante estos cambios.',
    button: {
      text: 'Leer más',
      href: '/maestria/sostenibilidad-turistica-ecoturismo',
      variant: 'primary',
    },
  },
];
---

<Layout metadata={metadata}>
  <Hero
    tagline="Oferta de maestrías"
    image={{
      src: '~/assets/images/fvi_maestrias_home.webp',
      alt: 'Oferta de maestrías de Fondo Verde Institute',
    }}
  >
    <Fragment slot="title">
      Maestrías
      <span class="text-primary dark:text-accent"> online</span>
    </Fragment>
    <Fragment slot="subtitle">
      <span class="text-primary font-semibold">Fondo Verde</span>{' '}
      <span class="text-secondary font-semibold">Institute</span> ofrece una formación de posgrado
      en medio ambiente, sostenibilidad, territorio y gestión ambiental para profesionales de Iberoamérica.
    </Fragment>
  </Hero>

  <Features3
    id="presentacion"
    title="Oferta de maestrías de Fondo Verde"
    subtitle="Una estructura pensada para combinar formación académica, flexibilidad y desarrollo profesional en torno al medio ambiente."
    columns={3}
    items={[
      {
        title: 'Estructura del programa',
        description:
          'La maestría tiene una duración de seis trimestres, equivalentes a 2 años, con 1,440 horas lectivas y 90 créditos.',
        icon: 'tabler:calendar-time',
      },
      {
        title: 'Formación base',
        description:
          'Tres trimestres iniciales con nueve cursos diseñados para proporcionar una sólida base en las áreas centrales del programa.',
        icon: 'tabler:school',
      },
      {
        title: 'Proyecto terminal',
        description:
          'Durante el cuarto y quinto trimestre el alumno desarrolla su Proyecto Terminal de Maestría y posteriormente acredita la opción terminal de titulación.',
        icon: 'tabler:clipboard-list',
      },
    ]}
  />

  <FeaturedPrograms
    id="programas-listado"
    tagline="Programas de maestría"
    columns={2}
    items={maestriaPrograms}
  />
</Layout>