---
import ProgramShowcase from '~/components/widgets/ProgramShowcase.astro';
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';
import { programs } from '~/data/programs';
import { getProgramsByCategory } from '~/utils/programs';
import Features from '~/components/widgets/Features.astro';

const metadata = {
  title: 'Doctorados Oficiales en Medio Ambiente',
  description: 'Alcanza el grado de PhD con nuestros doctorados multidisciplinarios. Desarrolla investigación rigurosa y genera un impacto global en tu región.',
  keywords: 'doctorado en medio ambiente, PhD ambiental, investigación científica, desarrollo sustentable, doctorado online, Fondo Verde, tesis doctoral',
};

const phdPrograms = getProgramsByCategory(programs, 'doctorado');
---

<Layout metadata={metadata}>
  <Hero
    tagline="Presentación"
    image={{
      src: '~/assets/images/fvi_doctorados_home.webp',
      alt: 'Programas de Doctorado de Fondo Verde Institute',
    }}
  >
    <Fragment slot="title">
      Doctorados
      <span class="text-primary dark:text-accent"> oficiales</span>
    </Fragment>
    <Fragment slot="subtitle">
      Los programas de doctorado de Fondo Verde ofrecen una especialización de alto nivel diseñada para generar un impacto directo en el desarrollo de tu comunidad o región. A través de metodologías avanzadas en estudios medioambientales y planificación del desarrollo, adquirirás las competencias clave para la investigación de excelencia.<br>
      El programa te sumerge en una cultura científica interdisciplinaria, guiando tu formación hacia la consolidación de un proyecto riguroso y coherente. Este proceso culmina con la defensa de una tesis de investigación original, otorgándote el grado equivalente al PhD (Philosophiæ Doctor).
    </Fragment>
  </Hero>

  <Features
    id="estructura"
    tagline="Fases y Carga Lectiva"
    title="Estructura del Programa"
    subtitle="Nuestros <strong>doctorados</strong> son programas multidisciplinarios diseñados bajo una progresión académica rigurosa. Esta ruta articula un <strong>periodo de formación avanzada</strong>, un <strong>periodo de investigación</strong> con el desarrollo de la <strong>Tesis Doctoral</strong> y la publicación de un <strong>artículo científico</strong>. Según el programa elegido, la duración total está preestablecida en 24 o 36 meses, con una carga académica fijada en 75, 90 o 100 créditos (1,200, 1,440 o 1,600 horas lectivas). <em>Los detalles exactos se especifican en la ficha técnica de cada doctorado.</em>"
    columns={2}
    classes={{
      container: 'max-w-7xl',
      items: {
        panel: 'max-w-none w-full',
      },
    }}
    items={[
      {
        title: 'Periodo de formación',
        description:
          'Comprende una secuencia básica de cuatro trimestres integrados por 9 a 12 cursos teóricos, estratégicamente alineados a la mención doctoral y al trabajo de investigación. Desde el momento de la admisión, la Comisión Académica asigna un Tutor experto que guiará al estudiante en la estructuración de su plan de estudios y dará seguimiento a su desarrollo.',
        icon: 'tabler:school',
      },
      {
        title: 'Periodo de investigación',
        description:
          'Esta fase práctica se desarrolla mediante <strong>seminarios de investigación</strong> enfocados en la problemática ambiental elegida por el estudiante. El proceso culmina con la redacción del trabajo final de la <strong>Tesis Doctoral</strong> y la elaboración de un <strong>artículo científico</strong>, de revisión o derivado de la propia tesis, listo para su publicación.',
        icon: 'tabler:microscope',
      },
    ]}
  />

  <ProgramShowcase id="programas-listado" tagline="Programas de Doctorado" columns={2} items={phdPrograms} />
</Layout>
