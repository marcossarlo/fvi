---
import Content from '~/components/widgets/Content.astro';
import FeaturedPrograms from '~/components/widgets/FeaturedPrograms.astro';
import HeroPrograms from '~/components/widgets/HeroPrograms.astro';
import Layout from '~/layouts/PageLayout.astro';
import type { ItemFeaturedProgram } from '~/types';

const metadata = {
  title: 'PhD | Doctorados oficiales en medio ambiente | Fondo Verde Institute',
  description:
    'Conoce la oferta de doctorados PhD de Fondo Verde Institute: sostenibilidad, energía, educación ambiental, turismo, urbanismo y más, con formación doctoral especializada en medio ambiente.',
  keywords:
    'PhD, doctorados oficiales, doctorado en medio ambiente, sostenibilidad, educación ambiental, energías renovables, ecoturismo, urbanismo sostenible, Fondo Verde Institute',
};

const phdStartDate = '13 de mayo de 2026';

const phdPrograms: ItemFeaturedProgram[] = [
  {
    image: '~/assets/images/doctorados/fvi-phd-sostenibilidad.webp',
    title: '<span class="text-primary">Doctorado en</span> Sostenibilidad',
    date: phdStartDate,
    description:
      'Forma investigadores capaces de generar conocimiento innovador sobre cambio climático, gestión de recursos naturales y desarrollo sostenible.',
    button: {
      text: 'Leer más',
      href: '/phd/sostenibilidad',
      variant: 'primary',
    },
  },
  {
    image: '~/assets/images/doctorados/fvi-phd-conservacion-restauracion-medio-natural.webp',
    title: '<span class="text-primary">Doctorado en</span> Conservación y Restauración del Medio Natural',
    date: phdStartDate,
    description:
      'Aborda medicina de la conservación, salud de ecosistemas y recuperación de hábitats degradados con enfoque interdisciplinario.',
    button: {
      text: 'Leer más',
      href: '/phd/conservacion-restauracion-medio-natural',
      variant: 'primary',
    },
  },
  {
    image: '~/assets/images/doctorados/fvi-phd-proyectos-investigacion-medio-ambiente.webp',
    title: '<span class="text-primary">Doctorado en</span> Proyectos: Línea de Investigación en Medio Ambiente',
    date: phdStartDate,
    description:
      'Prepara profesionales para planear, formular y gestionar proyectos ambientales con impacto urbano y rural.',
    button: {
      text: 'Leer más',
      href: '/phd/proyectos-investigacion-medio-ambiente',
      variant: 'primary',
    },
  },
  {
    image: '~/assets/images/doctorados/fvi-phd-administracion-negocios-sostenibles.webp',
    title: '<span class="text-primary">Doctorado en</span> Administración de Negocios Sostenibles',
    date: phdStartDate,
    description:
      'Diseña modelos de negocio, finanzas verdes y liderazgo ético orientados a la economía circular.',
    button: {
      text: 'Leer más',
      href: '/phd/administracion-negocios-sostenibles',
      variant: 'primary',
    },
  },
  {
    image: '~/assets/images/doctorados/fvi-phd-educacion-ambiental.webp',
    title: '<span class="text-primary">Doctorado en</span> Educación Ambiental',
    date: phdStartDate,
    description:
      'Fortalece la investigación y la práctica pedagógica para impulsar cultura ambiental y participación ciudadana.',
    button: {
      text: 'Leer más',
      href: '/phd/educacion-ambiental',
      variant: 'primary',
    },
  },
  {
    image: '~/assets/images/doctorados/fvi-phd-paisaje-ambiente.webp',
    title: '<span class="text-primary">Doctorado en</span> Paisaje y Ambiente',
    date: phdStartDate,
    description:
      'Estudia el paisaje como recurso territorial para conservación, planificación y restauración con mirada transdisciplinaria.',
    button: {
      text: 'Leer más',
      href: '/phd/paisaje-ambiente',
      variant: 'primary',
    },
  },
  {
    image: '~/assets/images/doctorados/fvi-phd-ecoturismo-turismo-sostenible.webp',
    title: '<span class="text-primary">Doctorado en</span> Ecoturismo y Turismo Sostenible',
    date: phdStartDate,
    description:
      'Impulsa la gestión de destinos y productos turísticos responsables con enfoque local e internacional.',
    button: {
      text: 'Leer más',
      href: '/phd/ecoturismo-turismo-sostenible',
      variant: 'primary',
    },
  },
  {
    image: '~/assets/images/doctorados/fvi-phd-urbanismo-arquitectura-sostenible.webp',
    title: '<span class="text-primary">Doctorado en</span> Urbanismo y Arquitectura Sostenible',
    date: phdStartDate,
    description:
      'Integra diseño, ciudad y territorio para crear entornos más eficientes, habitables y ambientalmente responsables.',
    button: {
      text: 'Leer más',
      href: '/phd/urbanismo-arquitectura-sostenible',
      variant: 'primary',
    },
  },
  {
    image: '~/assets/images/doctorados/fvi-phd-energias-renovables.webp',
    title: '<span class="text-primary">Doctorado en</span> Energías Renovables',
    date: phdStartDate,
    description:
      'Desarrolla soluciones en energía solar, eólica, biomasa e hidrógeno para acelerar la transición energética.',
    button: {
      text: 'Leer más',
      href: '/phd/energias-renovables',
      variant: 'primary',
    },
  },
];
---

<Layout metadata={metadata} showSecondaryNav={false}>
  <HeroPrograms
    tagline="Oferta doctoral"
    subtitle="Investigación especializada para formar doctores con visión ambiental, interdisciplinaria y alcance internacional."
    actions={[
      {
        variant: 'primary',
        text: 'Ver programas',
        href: '#programas',
        icon: 'tabler:school',
        class: '!bg-primary !border-primary !text-white hover:!bg-secondary hover:!border-secondary transition-colors duration-300',
      },
      {
        variant: 'secondary',
        text: 'Leer presentación',
        href: '#presentacion',
        icon: 'tabler:file-description',
        class: '!bg-transparent !text-white !border-[1px] !border-solid !border-white/50 hover:!bg-white/10 hover:!text-white hover:!border-white transition-all duration-300',
      },
    ]}
    image={{
      src: '~/assets/images/fvi_doctorados_home.webp',
      alt: 'Oferta doctoral de Fondo Verde Institute',
    }}
  >
    <Fragment slot="title">
      PhD <br />
      <span class="text-secondary dark:text-accent">Doctorados oficiales</span>
    </Fragment>
  </HeroPrograms>

  <Content
    id="presentacion"
    tagline="Presentación"
    title='Oferta doctoral de <span class="text-primary">Fondo Verde</span>'
    subtitle="Una estructura doctoral pensada para investigadores que quieren profundizar en medio ambiente, sostenibilidad y desarrollo territorial."
    content={`
      <p>La oferta doctoral de <strong>Fondo Verde</strong> es altamente especializada y busca provocar un efecto global en el desarrollo y crecimiento de la comunidad o región de desempeño del investigador, a través de introducir al alumno en las diversas metodologías para el estudio del medio ambiente y la planeación del desarrollo.</p>
      <p>El programa aporta a los investigadores en formación una cultura interdisciplinaria vinculada con un proyecto científico coherente. El título de doctor expresa una investigación cimentada en la defensa de una tesis basada en una investigación original, por tanto, el equivalente al <strong>PhD</strong> o <em>Philosophiæ Doctor</em>.</p>
      <p>El doctorado se estructura en un periodo de formación y un periodo de investigación, articulando competencias para producir tesis, publicaciones científicas y aportes de alto nivel al conocimiento ambiental.</p>
    `}
    items={[
      {
        title: 'Estructura del programa',
        description:
          '24 meses, 8 trimestres, 1,440 horas lectivas y 90 créditos, con un periodo de formación, un periodo de investigación, proyecto de tesis doctoral y artículo científico.',
        icon: 'tabler:calendar-time',
      },
      {
        title: 'Periodo de formación',
        description:
          'Cuatro trimestres con doce cursos teóricos, orientados por un tutor académico designado por la Comisión Académica del Doctorado.',
        icon: 'tabler:school',
      },
      {
        title: 'Periodo de investigación',
        description:
          'Seminarios de seguimiento, tesis doctoral y publicación de un artículo científico de revisión y/o sobre la temática de la tesis.',
        icon: 'tabler:microscope',
      },
    ]}
    columns={3}
    image={{
      src: '~/assets/images/fvi_doctorados_home.webp',
      alt: 'Doctorados oficiales de Fondo Verde Institute',
    }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-pageDark"></div>
    </Fragment>
  </Content>

  <section id="programas" class="relative py-20 md:py-24 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-white via-white to-blue-50/80 dark:from-slate-950 dark:via-page dark:to-pageDark"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10 md:mb-14">
        <span class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-4 py-2 text-sm font-semibold uppercase tracking-[0.2em] text-primary dark:text-accent">
          Doctorados disponibles
        </span>
        <h2 class="mt-5 text-3xl md:text-4xl font-bold tracking-tighter text-default dark:text-white">
          Conoce la oferta PhD publicada por Fondo Verde
        </h2>
        <p class="mt-4 text-base md:text-lg text-muted dark:text-slate-300 max-w-2xl">
          Cada programa combina investigación aplicada, acompañamiento académico y una línea de especialización clara para profesionales que buscan una formación doctoral de alto nivel.
        </p>
      </div>

      <FeaturedPrograms
        id="programas-listado"
        tagline="Programas PhD"
        columns={2}
        items={phdPrograms}
      />
    </div>
  </section>
</Layout>