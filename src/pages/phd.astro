---
import ProgramShowcase from '~/components/widgets/ProgramShowcase.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';
import { programs } from '~/data/programs';
import { getProgramsByCategory } from '~/utils/programs';

const metadata = {
  title: 'PhD | Doctorados oficiales en medio ambiente | Fondo Verde Institute',
  description:
    'Conoce la oferta de doctorados PhD de Fondo Verde Institute: sostenibilidad, energía, educación ambiental, turismo, urbanismo y más, con formación doctoral especializada en medio ambiente.',
  keywords:
    'PhD, doctorados oficiales, doctorado en medio ambiente, sostenibilidad, educación ambiental, energías renovables, ecoturismo, urbanismo sostenible, Fondo Verde Institute',
};

const phdPrograms = getProgramsByCategory(programs, 'doctorado');
---

<Layout metadata={metadata}>
  <Hero
    tagline="Oferta doctoral"
    image={{
      src: '~/assets/images/fvi_doctorados_home.webp',
      alt: 'Oferta doctoral de Fondo Verde Institute',
    }}
  >
    <Fragment slot="title">
      Doctorados
      <span class="text-primary dark:text-accent"> oficiales</span>
    </Fragment>
    <Fragment slot="subtitle">
      <span class="text-primary font-semibold">Fondo Verde</span>
      <span class="text-secondary font-semibold">Institute</span>, se funda en el entorno de <a
        href="https://www.fondoverde.org"
        class="font-bold text-primary hover:text-secondary dark:text-primary dark:hover:text-secondary transition-colors decoration-2 underline-offset-2"
        target="_blank"
        rel="noopener noreferrer"
      >
        FONDO VERDE</a
      >, una <strong>ONGD internacional</strong> miembro de <strong
        >IUCN International Union for Conservation of Nature</strong
      >. Fondo Verde es una organización líder en el sector de formación ambiental con más de 16 años de experiencia.
      Esta experiencia ha permitido apostar por la innovación a través de una oferta educativa que genera un impacto
      positivo en el mundo.
    </Fragment>
  </Hero>

  <Features3
    id="presentacion"
    title="Oferta doctoral de Fondo Verde"
    subtitle="Una estructura doctoral pensada para investigadores que quieren profundizar en medio ambiente, sostenibilidad y desarrollo territorial."
    columns={3}
    items={[
      {
        title: 'Estructura del programa',
        description:
          '24 meses, 8 trimestres, 1,440 horas lectivas y 90 créditos, con un periodo de formación, un periodo de investigación, proyecto de tesis doctoral y artículo científico.',
        icon: 'tabler:calendar-time',
      },
      {
        title: 'Periodo de formación',
        description:
          'Cuatro trimestres con doce cursos teóricos, orientados por un tutor académico designado por la Comisión Académica del Doctorado.',
        icon: 'tabler:school',
      },
      {
        title: 'Periodo de investigación',
        description:
          'Seminarios de seguimiento, tesis doctoral y publicación de un artículo científico de revisión y/o sobre la temática de la tesis.',
        icon: 'tabler:microscope',
      },
    ]}
  />

  <ProgramShowcase id="programas-listado" tagline="Programas PhD" columns={2} items={phdPrograms} />
</Layout>
