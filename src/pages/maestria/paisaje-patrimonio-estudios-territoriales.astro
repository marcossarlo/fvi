---
import Layout from '~/layouts/PageLayout.astro';
import HeroPrograms from '~/components/widgets/HeroPrograms.astro';
import StatsData from '~/components/maestria/StatsData.astro';
import ProgramTOC from '~/components/widgets/ProgramTOC.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import HeroSection from '~/components/widgets/HeroSection.astro';
import ProgramCurriculum from '~/components/maestria/ProgramCurriculum.astro';
import ProjectPTM from '~/components/maestria/ProjectPTM.astro';
import ProjectLocations from '~/components/maestria/ProjectLocations.astro';
import { paisajePatrimonioEstudiosTerritorialesCurriculum } from '~/data/maestria/paisaje-patrimonio-estudios-territoriales';

import Scholarship from '~/components/maestria/Scholarship.astro';
import Registration from '~/components/maestria/Registration.astro';
import PaymentMethods from '~/components/maestria/PaymentMethods.astro';
import Requests from '~/components/maestria/Requests.astro';
import HowToStudy from '~/components/maestria/HowToStudy.astro';
import ClaustroInfo from '~/components/maestria/ClaustroInfo.astro';
import PostMaestria from '~/components/maestria/PostMaestria.astro';
import FacultyMember from '~/components/widgets/FacultyMember.astro';
import { faculty } from '~/data/faculty';
import Features from '~/components/widgets/Features.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Degree from '~/components/common/Degree.astro';
import HowToApply from '~/components/maestria/HowToApply.astro';

const metadata = {
    title: 'Maestría en Medio Ambiente y Responsabilidad Social',
    description: 'Estudia la Maestría online en Medio Ambiente y Responsabilidad Social. Fórmate como líder en gestión ambiental, RSC y estrategias de economía sostenible.',
    keywords: 'maestría medio ambiente, responsabilidad social, gestión ambiental, economía sostenible, RSC, ISO 14001, proyecto terminal, becas Fondo Verde',
};

const facultyIds = [
    'gonzalo-fuente',
    'angela-martin',
    'susan-smith',
];
const facultyList = facultyIds.map(id => faculty[id]).filter(Boolean);

const tabs = [
    { id: 'bienvenida', label: '1. Bienvenida' },
    { id: 'maestria', label: '2. La Maestría' },
    { id: 'colaboran', label: '3. Colaboran' },
    { id: 'estructura', label: '4. Estructura' },
    { id: 'proyecto', label: '5. Proyecto' },
    { id: 'estudio', label: '6. ¿Cómo se estudia?' },
    { id: 'claustro', label: '7. Claustro' },
    { id: 'beneficios', label: '8. Beneficios' },
    { id: 'titulacion', label: '9. Titulación' },
    { id: 'postmaestria', label: '10. Post Maestría' },
    { id: 'becas', label: '11. Becas' },
    { id: 'aplicar', label: '12. ¿Cómo aplicar?' },
    { id: 'inscripcion', label: '13. Inscripción' },
    { id: 'medios-de-pago', label: '14. Medios de Pago' },
    { id: 'solicitudes', label: '15. Solicitudes' },
];
---

<Layout metadata={metadata} showSecondaryNav={false}>
    {/* HeroPrograms ********************************************** */}
    <HeroPrograms
        tagline='Convocatoria Abierta 2026'
        title='Maestría en<br /> <span class="text-primary">Paisaje, Patrimonio y Estudios Territoriales</span>'
        subtitle='<strong>Anímate a salvar el paisaje</strong>, Anímate a salvar tu país.'
        actions={[
        {
            variant: 'primary',
            text: 'Solicita información',
            href: '#solicitudes',
            icon: 'tabler:mail-forward',
            class: '!bg-primary !border-primary !text-white hover:!bg-secondary hover:!border-secondary transition-colors duration-300',
        },
        {
            variant: 'secondary',
            text: 'Ver Folleto Académico',
            href: 'https://drive.google.com/file/d/0B0HLluZifC0PS1BfMEwwNXpQRFk/view',
            target: '_blank',
            icon: 'tabler:download',
            class: '!bg-transparent !text-white !border-[1px] !border-solid !border-white/50 hover:!bg-white/10 hover:!text-white hover:!border-white transition-all duration-300',
        },
        ]}
        image={{
        src: '~/assets/images/maestrias/fvi-msc-paisaje-patrimonio-estudios-territoriales.webp',
        alt: 'Imagen de la Maestría en Paisaje, Patrimonio y Estudios Territoriales',
        }}
    />

    {/* DatosEstadisticas */}
    <StatsData />

    <div class="relative max-w-[100vw] overflow-x-hidden">
        <!-- Desktop Sidebar & Mobile Floating Pill -->
        <ProgramTOC tabs={tabs} />

        {/* Main Content Wrapper that creates space for the Desktop Sidebar */}
        <div class="lg:ml-64 2xl:ml-[18rem] pb-24 lg:pb-0 transition-all duration-300">
        
        {/* 1. BIENVENIDA */}
        <Content
            id="bienvenida"
            tagline="Bienvenida"
            title="Gonzalo de la Fuente de Val, Dr."
            subtitle="Director de la Maestría"
            items={[
                {
                title: 'Paisajes en crisis y deterioro',
                description: 'El paisaje atraviesa hoy una situación crítica. Paisajes valiosos deteriorados, pérdida de tramas construidas y su sustitución por configuraciones banalizadas, evidencia la desidia en su gestión.',
                icon: 'tabler:alert-triangle',
                },
                {
                title: 'Métodos para la gestión y conservación del paisaje',
                description: 'Es por tanto de gran interés, conocer los métodos y aproximaciones al estudio del paisaje, para dar respuesta a problemas prácticos de gestión del territorio, tanto desde la perspectiva de la valoración del paisaje como recurso para la conservación de áreas naturales, como para la planificación de los usos del territorio o incluso para restaurarzonas alteradas.',
                icon: 'tabler:map-search',
                }
            ]}
            image={{
                src: '~/assets/images/users/fvi-gonzalo-fuente.webp',
                alt: 'Gonzalo de la Fuente de Val, Dr. - Director de la Maestría en Paisaje, Patrimonio y Estudios Territoriales',
            }}
            >
            <Fragment slot="bg">
                <div class="absolute inset-0 bg-blue-50 dark:bg-pageDark"></div>
            </Fragment>
        </Content>
        
        {/* 2. LA MAESTRÍA */}
        <Features2
            id="maestria"
            tagline="La Maestría"
            title="¿Por qué hacer esta maestría?"
            subtitle="Acostumbrados a ver paisajes degradados y banalizados como evidencia de una desidia en su gestión, emerge la necesidad de recuperar, transformar y crear paisajes de calidad como expresión indisociable de una correcta gestión y ordenación paisajística del territorio."
            columns={2}
            items={[
            {
                title: 'Diversidad de métodos en el estudio del paisaje',
                description: 'La amplia variedad de aspectos que abarca el paisaje ha llevado a una multiplicidad de métodos de análisis y evaluación, con objeto de poner en valor un recurso cada vez más escaso, sin embargo no existe un modelo determinado y fijo. Es por tanto de gran interés, conocer los métodos y aproximaciones al estudio del paisaje, para dar respuesta a problemas prácticos de gestión del territorio, tanto desde la perspectiva de la valoración del paisaje como recurso para la conservación de áreas naturales, como para la planificación de los usos del territorio o incluso para restaurar zonas alteradas',
                icon: 'tabler:layers-intersect',
            },
            {
                title: 'Oportunidades profesionales en el campo del paisaje',
                description: 'Las expectativas laborales del egresado son altas y en diversos campos: ámbito público, sector privado, en oficinas y consultoras dedicadas a estudios de paisaje, planificación territorial, paisajismo. Según algunas estadísticas, más del 50% de los profesionales del paisaje trabajan al primer año de egreso.',
                icon: 'tabler:briefcase',
            }
            ]}
        >
        </Features2>
        
        {/* ¿Quiénes deben asistir? */}
        <Content
            isReversed
            items={[
                {
                    title: 'Arquitectos y especialistas en territorio',
                    description: 'Arquitectos, urbanistas, biólogos, ecólogos e ingenieros que intervienen en procesos de desarrollo y gestión mediante proyectos en el territorio.',
                    icon: 'tabler:building-community',
                },
                {
                    title: 'Ingenieros y técnicos de proyectos',
                    description: 'Profesionales dedicados a la redacción y ejecución de proyectos de urbanismo, transporte, energía, agricultura y forestales.',
                    icon: 'tabler:tools',
                },
                {
                    title: 'Ingenieros y arquitectos ambientales',
                    description: 'Especialistas en la Evaluación Ambiental de Planes y Proyectos.',
                    icon: 'tabler:leaf',
                },
                {
                    title: 'Empleados públicos en planificación',
                    description: 'Responsables de la planificación y gestión del desarrollo, ordenación territorial y urbanismo.',
                    icon: 'tabler:building-bank',
                },
                {
                    title: 'Consultores en paisaje',
                    description: 'Consultores interesados en profundizar en temas relacionados con el paisaje urbano y rural.',
                    icon: 'tabler:search',
                },
                {
                    title: 'ONG y funcionarios de turismo y cultura',
                    description: 'Personas vinculadas con ONGs y funcionarios públicos en oficinas de turismo, cultura y ambiente a nivel nacional, departamental o municipal.',
                    icon: 'tabler:users-group',
                },
                {
                    title: 'Responsables y técnicos municipales',
                    description: 'Responsables y técnicos municipales y regionales en planificación urbana.',
                    icon: 'tabler:map',
                },            
            ]}
            image={{
                src: '~/assets/images/maestrias/fvi-quienes-deben-asistir-msc-ppet.jpg',
                alt: '¿Quiénes deben asistir a la Maestría en Paisaje, Patrimonio y Estudios Territoriales?',
            }}
        >
            <Fragment slot="content">
            <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
                ¿Quiénes deben asistir?
            </h3>
            </Fragment>
        </Content>
        {/* ¿Qué vas a aprender? */}
        <Content
            items={[
            {
                description: 'Comprender la visión general del estudio del paisaje y conocer los principales instrumentos y principios de gestión y ordenación.',
                icon: 'tabler:school',
            },
            {
                description: 'Analizar aspectos esenciales para la consideración del patrimonio y el paisaje cultural como recurso en el ámbito local, con participación de la comunidad y actores en diferentes campos de acción.',
                icon: 'tabler:users',
            },
            {
                description: 'Explicar la forma de inventariar, diagnosticar, planificar y gestionar el paisaje, directamente o mediante planes integrales o sectoriales.',
                icon: 'tabler:clipboard-list',
            },
            {
                description: 'Establecer claves de interpretación del patrimonio natural considerando aspectos del paradigma de la complejidad.',
                icon: 'tabler:book',
            },
            {
                description: 'Proveer información sobre procesos de formación y degradación del paisaje, así como métodos para prevenir, corregir y restaurar degradaciones y crear nuevos paisajes.',
                icon: 'tabler:leaf',
            },
            {
                description: 'Elaborar propuestas de conservación de los valores patrimoniales asociados a los recursos paisajísticos.',
                icon: 'tabler:shield-check',
            },
            {
                description: 'Deducir cómo se introduce el paisaje en la planificación territorial y urbanística existente.',
                icon: 'tabler:map',
            },

            ]}
            image={{
            src: '~/assets/images/maestrias/fvi-que-vas-aprender-msc-mars.webp',
            alt: '¿Qué vas a aprender en la Maestría en Medio Ambiente y Responsabilidad Social?',
            }}
        >
            <Fragment slot="content">
            <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
                ¿Qué vas a aprender?
            </h3>
            </Fragment>
        </Content>

        {/* 3. COLABORAN */}
        <HeroSection
            id="colaboran"
            tagline="Colaboran"
            title='Entidades Colaboradoras'
            image={{
                src: '~/assets/images/maestrias/fvi-colaboran-msc-ppet.jpg',
                alt: 'Entidades colaboradoras de la Maestría en Paisaje, Patrimonio y Estudios Territoriales',
            }}
        >
            <Fragment slot="bg">
                <div class="absolute inset-0 bg-blue-50 dark:bg-pageDark"></div>
            </Fragment>
        </HeroSection>

        {/* 4. ESTRUCTURA DEL PROGRAMA */}
        <HeroSection
            id="estructura"
            tagline="Estructura"
            title='Estructura del Programa'
            subtitle='La <span class="text-primary font-semibold"> Maestría en</span> <span class="text-secondary font-semibold">Paisaje, Patrimonio y Estudios Territoriales</span> tiene una duración de <strong>seis trimestres (2 años)</strong> con un total de <strong>1,440 horas lectivas (90 créditos)</strong>. Su plan de estudios está compuesto de una secuencia básica de tres trimestres donde se imparten nueve cursos diseñados para dar una sólida formación en las áreas centrales del programa. Durante el cuarto y quinto trimestre, el alumno desarrolla su <strong>Proyecto Terminal de Maestría</strong> - <strong>PTM</strong>; posteriormente en el sexto trimestre, el alumno deberá acreditar la opción terminal de titulación y realizar sus trámites de graduación de acuerdo a la modalidad que haya elegido.'
        >
            <Fragment slot="content">
                <ProgramCurriculum courses={paisajePatrimonioEstudiosTerritorialesCurriculum.courses} />
            </Fragment>
        </HeroSection>

        {/* 5. PROYECTO PTM (commond) */}
        <ProjectPTM />

        {/* 6. COMO SE ESTUDIA (commond) */}
        <HowToStudy />

        {/* 7. CLAUSTRO */}
        <ClaustroInfo />
        {
            facultyList.map((prof) => (
            <FacultyMember {...prof}>
                <Fragment slot="bg">
                <div class="absolute inset-0 bg-blue-50 dark:bg-pageDark" />
                </Fragment>
            </FacultyMember>
            ))
        }

        {/* 8. BENEFICIOS */}
        <Features
            id="beneficios"
            tagline='Beneficios'
            title="¿Cómo te beneficiará este programa?"
            subtitle='El egresado de la <span class="text-primary font-semibold"> Maestría en</span> <span class="text-secondary font-semibold">Medio Ambiente y Responsabilidad Social</span>, será capaz de:'
            columns={2}
            items={[
            {
                title: 'Visión Integral',
                description: 'Adquirir una visión integral de los problemas ambientales para desarrollar proyectos con herramientas de sostenibilidad.',
                icon: 'tabler:world',
            },
            {
                title: 'Normativa y Auditoría',
                description: 'Conocer la normativa pertinente y las herramientas de Gestión, Reporting, y Auditoría de la RSC: ISO 9001, ISO 14001, OHSAS 18001, SA 8000, SGE 21.',
                icon: 'tabler:gavel',
            },
            {
                title: 'Fundamentos Socio-económicos',
                description: 'Comprender los fundamentos socio-económicos y científicos de los problemas relacionados con la biosfera y ofrecer una solución con perspectiva interdisciplinaria, integradora y sistémica.',
                icon: 'tabler:brain',
            },
            {
                title: 'Desarrollo Sostenible',
                description: 'Obtener los conocimientos y habilidades necesarias para contribuir a la construcción de una sociedad socio-económica y ambientalmente sostenible.',
                icon: 'tabler:building-community',
            },
            {
                title: 'Gestión Organizacional',
                description: 'Identificar y responder a los desafíos que enfrenta una gestión ambiental integral y sistémica de organizaciones públicas, privadas o del tercer sector ya sea como parte de un proceso de desarrollo o de transformación con responsabilidad socio-ambiental.',
                icon: 'tabler:chart-arrows-vertical',
            },
            {
                title: 'Resolución de Conflictos',
                description: 'Tomar conciencia de los conflictos socio-ambientales subyacentes a la actividad económica y proponer soluciones sistémicas e integradoras.',
                icon: 'tabler:puzzle',
            },
            {
                title: 'Responsabilidad Social (RSC)',
                description: 'Ser conocedor de la función de la responsabilidad social corporativa en la empresa moderna, su desempeño social y ambiental, y la aplicación del ISO 26,000.',
                icon: 'tabler:briefcase',
            },
            ]}
        />
        {/* Potencia tus salidas */}
        <Features3
            title="Potencia tus Salidas Profesionales"
            subtitle='La <span class="text-primary font-semibold"> Maestría en</span> <span class="text-secondary font-semibold">Medio Ambiente y Responsabilidad Social</span>, prepara al alumno/a para trabajar en organizaciones tanto públicas como privadas, son profesionales que cultivan la ética en los negocios, la buena praxis y la responsabilidad corporativa. Las salidas profesionales, se centran claramente en:'
            columns={3}
            defaultIcon="tabler:point-filled"
            items={[
            {
                title: 'Organizaciones ambientales',
                description: 'En posiciones operativas y estratégicas en organizaciones que se dedican específicamente a la investigación y conservación de los recursos naturales.',
            },
            {
                title: 'Unidades de negocios',
                description: 'En unidades de negocios ambientales de organizaciones públicas y privadas de grandes dimensiones.',
            },
            {
                title: 'Comunicación de impacto',
                description: 'Organizaciones o unidades de negocios que comunican impactos socio/ambientales a la comunidad en general.',
            },
            {
                title: 'Equipos de investigación',
                description: 'Como parte de un equipo interdisciplinario de investigación socio-económico y ambiental.',
            },
            {
                title: 'Dirección o Gestión',
                description: 'Director o Gestor del área de Medio Ambiente de empresas.',
            },
            {
                title: 'Líder en Sostenibilidad',
                description: 'Profesional Líder en la planificación, desarrollo, gestión e implementación de diferentes estrategias de Sostenibilidad, Medio Ambiente y RSC.',
            },
            {
                title: 'Responsable de sistemas',
                description: 'Responsable del sistema de gestión medioambiental en empresa.',
            },
            {
                title: 'Técnico y consultoría',
                description: 'Técnico de outsourcing ambiental y consultoría de proyectos.',
            },
            {
                title: 'Implantación de sistemas',
                description: 'Consultor en implantación de sistemas de gestión medioambiental.',
            },
            {
                title: 'Educación ambiental',
                description: 'Coordinador de equipos de educación ambiental/Director de centro de educación ambiental.',
            },
            {
                title: 'Gestor ambiental',
                description: 'Gestor ambiental de industrias y/o empresas públicas y privadas que enfrentan grandes retos socio/ambientales en su gestión.',
            },
            ]}
        />
        {/* Pasantía Técnica Internacional (Más allá del Programa) */}
        <HeroSection
            tagline="Pasantía Técnica Internacional"
            title="Inmersión de capacitación intensiva en programas de apoyo al desarrollo sostenible"
            subtitle='La <strong>Pasantía Técnica Internacional</strong><span class="text-secondary">*</span>, es un viaje de estudios opcional, de una semana de duración, a un destino internacional. Se elabora un Plan Individual de Capacitación, acorde a los temas de interés y tiempo de permanencia. La pasantía es esencialmente teórica-práctica, los pasantes participan de los proyectos de las entidades anfitrionas y de todas las actividades de capacitación programadas por el equipo técnico local. Visitan iniciativas de proyectos e interactúan con los beneficiarios.'
        >
            <Fragment slot="content">
            <ProjectLocations />
            <p class="text-red-600 dark:text-red-400 italic text-sm text-right mt-6 w-full">
                * Este servicio no está incluido en el coste de la maestría.
            </p>
            </Fragment>
        </HeroSection>

        {/* 9. TITULACIÓN */}
        <HeroSection
            id="titulacion"
            tagline="titulacion"
            title='Evaluación y Titulación'
        >
            <Fragment slot="bg">
                <div class="absolute inset-0 bg-blue-50 dark:bg-pageDark"></div>
            </Fragment>
            <Fragment slot="content">
            <h3 class="text-left text-xl font-bold tracking-tight text-primary dark:text-accent sm:text-2xl mb-4">Evaluación</h3>
            <p class="text-left">La evaluación es continua durante todo el período lectivo e incluye, según corresponda, participación en foros, trabajos escritos y cuestionarios por módulo. Además, cada participante debe desarrollar individualmente un <strong>Proyecto Terminal de Maestría</strong>, tutorizado por un experto y <strong>presentado y defendido ante un tribunal</strong>.</p>

            <h3 class="text-left text-xl font-bold tracking-tight text-primary dark:text-accent sm:text-2xl mt-6 mb-4">Titulación</h3>
            <p class="text-left mt-6 mb-8">Los participantes que hayan superado con éxito todas las materias y contenidos básicos, así como el <strong>Proyecto Terminal de Maestría</strong> obtendrán el grado de maestría.<br><br>Título de <span class="text-primary font-semibold"> Maestría en</span> <span class="text-secondary font-semibold">Medio Ambiente y Responsabilidad Social</span>, expedido por la <strong>Universidad Centro Panamericano de Estudios Superiores</strong>, Estudios con Reconocimiento de Validez Oficial - Acuerdo de Incorporación <span class="text-primary font-semibold">N° MAES180410</span>, Dirección de Educación Superior - Secretaría de Educación Pública.</p>
            
            {/* Diploma */}
            <Degree
                degreeName="MAESTRÍA EN MEDIO AMBIENTE Y RESPONSABILIDAD SOCIAL"
                incorporationNumber="MAES180410"
            />
            <p class="text-left mt-6 mb-8"><span class="italic">Desde México se realiza el proceso de apostillado por la Haya y la legitimación de firmas para que no tenga problemas a la hora de presentar los títulos en un país fuera de México</span>.</p>
            </Fragment>
        </HeroSection>

        {/* 10. POST MAESTRÍA (commond) */}
        <PostMaestria />

        {/* 11. BECAS (commond) */}
        <Scholarship />

        {/* 12. COMO APLICAR (commond) */}
        <HowToApply />

        {/* 13. INSCRIPCIÓN (commond) */}
        <Registration />

        {/* 14. MEDIOS DE PAGO (commond) */}
        <PaymentMethods />

        {/* 15. SOLICITUDES (commond) */}
        <Requests />

        </div>
    </div>
    <!-- END Desktop Sidebar & Mobile Floating Pill -->
</Layout>
