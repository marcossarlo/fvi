---
import Layout from '~/layouts/PageLayout.astro';
import HeroPrograms from '~/components/widgets/HeroPrograms.astro';
import StatsData from '~/components/maestria/StatsData.astro';
import ProgramTOC from '~/components/widgets/ProgramTOC.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import HeroSection from '~/components/widgets/HeroSection.astro';
import ProgramCurriculum from '~/components/maestria/ProgramCurriculum.astro';
import ProjectPTM from '~/components/maestria/ProjectPTM.astro';
import BeyondTheProgram from '~/components/maestria/BeyondTheProgram.astro';
import { rehabilitacionAmbientalTerrestreCurriculum } from '~/data/maestria/rehabilitacion-ambiental-terrestre';

import Scholarship from '~/components/maestria/Scholarship.astro';
import Registration from '~/components/maestria/Registration.astro';
import PaymentMethods from '~/components/maestria/PaymentMethods.astro';
import Requests from '~/components/maestria/Requests.astro';
import HowToStudy from '~/components/maestria/HowToStudy.astro';
import ClaustroInfo from '~/components/maestria/ClaustroInfo.astro';
import PostMaestria from '~/components/maestria/PostMaestria.astro';
import FacultyMember from '~/components/widgets/FacultyMember.astro';
import { faculty } from '~/data/faculty';
import Features from '~/components/widgets/Features.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Degree from '~/components/common/Degree.astro';
import HowToApply from '~/components/maestria/HowToApply.astro';

const metadata = {
    title: 'Maestría en Rehabilitación Ambiental Terrestre',
    description: 'Especialízate en restauración ecológica y rehabilitación ambiental terrestre. Diseña proyectos sostenibles y recupera ecosistemas degradados. ¡Estudia la Maestría en Rehabilitación Ambiental Terrestre',
    keywords: 'maestría en rehabilitación ambiental, restauración ecológica, ecosistemas degradados, ciencias ambientales, conservación de la naturaleza, proyectos de rehabilitación, servicios ecosistémicos',
};

const facultyIds = [
    'susan-smith',
    'gonzalo-fuente',
    'alberto-jimenez',
    'juan-silva',
    'angela-martin',
];
const facultyList = facultyIds.map(id => faculty[id]).filter(Boolean);

const tabs = [
    { id: 'bienvenida', label: '1. Bienvenida' },
    { id: 'maestria', label: '2. La Maestría' },
    { id: 'colaboran', label: '3. Colaboran' },
    { id: 'estructura', label: '4. Estructura' },
    { id: 'proyecto', label: '5. Proyecto' },
    { id: 'estudio', label: '6. ¿Cómo se estudia?' },
    { id: 'claustro', label: '7. Claustro' },
    { id: 'beneficios', label: '8. Beneficios' },
    { id: 'titulacion', label: '9. Titulación' },
    { id: 'postmaestria', label: '10. Post Maestría' },
    { id: 'becas', label: '11. Becas' },
    { id: 'aplicar', label: '12. ¿Cómo aplicar?' },
    { id: 'inscripcion', label: '13. Inscripción' },
    { id: 'medios-de-pago', label: '14. Medios de Pago' },
    { id: 'solicitudes', label: '15. Solicitudes' },
];
---

<Layout metadata={metadata} showSecondaryNav={false}>
    {/* HeroPrograms ********************************************** */}
    <HeroPrograms
        tagline='Convocatoria Abierta 2026'
        title='Maestría en<br /> <span class="text-primary">Rehabilitación Ambiental Terrestre</span>'
        subtitle='Sé parte de la <strong>ciencia que recupera la naturaleza</strong>'
        actions={[
        {
            variant: 'primary',
            text: 'Solicita información',
            href: '#solicitudes',
            icon: 'tabler:mail-forward',
            class: '!bg-primary !border-primary !text-white hover:!bg-secondary hover:!border-secondary transition-colors duration-300',
        },
        {
            variant: 'secondary',
            text: 'Ver Folleto Académico',
            href: 'https://drive.google.com/file/d/0B0HLluZifC0PLVMyWVVUaFFzTDg/edit?resourcekey=0-X6ccob-vzVlG3raAcn1dwA',
            target: '_blank',
            icon: 'tabler:download',
            class: '!bg-transparent !text-white !border-[1px] !border-solid !border-white/50 hover:!bg-white/10 hover:!text-white hover:!border-white transition-all duration-300',
        },
        ]}
        image={{
        src: '~/assets/images/maestrias/fvi-msc-rehabilitacion-ambiental-terrestre.jpg',
        alt: 'Imagen de la Maestría en Rehabilitación Ambiental Terrestre',
        }}
    />

    {/* DatosEstadisticas */}
    <StatsData />

    <div class="relative max-w-[100vw] overflow-x-hidden">
        <!-- Desktop Sidebar & Mobile Floating Pill -->
        <ProgramTOC tabs={tabs} />

        {/* Main Content Wrapper that creates space for the Desktop Sidebar */}
        <div class="lg:ml-64 2xl:ml-[18rem] pb-24 lg:pb-0 transition-all duration-300">
        
        {/* 1. BIENVENIDA */}
        <Content
            id="bienvenida"
            tagline="Bienvenida"
            title="Dra. Susan Smith"
            subtitle="Directora de la Maestría"
            items={[
                {
                    title: 'Bienvenida de la Directora de la Maestría',
                    description: 'La restauración ecológica, es una ciencia ambiental innovadora que aplica técnicas preventivas y correctoras de la degradación del medio natural y plantea la recuperación de forma sostenible, a largo plazo.<br><br>La intervención, tan mínima como sea posible, debe activar estos procesos que permitirán, a su debido tiempo, la reconstrucción del sistema. Por tanto, es importante incidir en su divulgación, lograr proyectos que demuestren sus ventajas bajo todo tipo de condiciones.',
                    icon: 'tabler:leaf',
                }
            ]}
            image={{
                src: '~/assets/images/users/fvi-susan-smith.webp',
                alt: 'Susan Smith, Dra. - Directora de la Maestría en Rehabilitación Ambiental Terrestre',
            }}
            >
            <Fragment slot="bg">
                <div class="absolute inset-0 bg-blue-50 dark:bg-pageDark"></div>
            </Fragment>
        </Content>
        
        {/* 2. LA MAESTRÍA */}
        <Features2
            id="maestria"
            tagline="La Maestría"
            title="¿Por qué hacer esta maestría?"
            subtitle='La <span class="text-primary font-semibold"> Maestría en</span> <span class="text-secondary font-semibold">Paisaje, Patrimonio y Estudios Territoriales</span> prepara profesionales capaces de diseñar y aplicar estrategias prácticas para la recuperación de áreas afectadas por disturbios antrópicos y naturales, combinando conocimientos científicos y enfoques multidisciplinarios para proyectos de restauración ecológica efectivos y sostenibles.'
            columns={2}
            items={[
            {
                title: 'Estrategias y formación',
                description: 'La restauración ecológica plantea y emplea técnicas y estrategias concretas para restablecer áreas degradadas. Esta maestría ofrece un entrenamiento multidisciplinario sólido que permite a los estudiantes analizar, diseñar y ejecutar proyectos de restauración con criterios técnicos y metodológicos claros.',
                icon: 'tabler:tools',
            },
            {
                title: 'Impacto y beneficios',
                description: 'La restauración puede mitigar la pérdida de biodiversidad y recuperar servicios ecosistémicos como la mejora de la calidad del agua y el almacenamiento de carbono. Según el PNUMA, restaurar ecosistemas dañados puede generar rendimientos ambientales y financieros positivos, crear empleo, reducir la pobreza y apoyar objetivos internacionales de conservación.',
                icon: 'tabler:leaf',
            }
            ]}
        >
        </Features2>
        
        {/* ¿Quiénes deben asistir? */}
        <Content
            isReversed
            items={[
                {
                    title: 'Titulados afines',
                    description: 'La Maestría está dirigida preferentemente a quienes estén en posesión de un título profesional universitario en un área afín a los recursos naturales.',
                    icon: 'tabler:school',
                    },
                    {
                    title: 'Profesionales ambientales',
                    description: 'Profesionales con o sin experiencia del área de ciencias ambientales y afines (agrónomos, biólogos, forestales, geógrafos, entre otros).',
                    icon: 'tabler:user-check',
                    },
                    {
                    title: 'Investigadores y gestores',
                    description: 'Investigadores, docentes, profesionales, estudiantes y representantes del sector público y privado cuyo interés y trabajo se enfoque en la restauración de ecosistemas degradados.',
                    icon: 'tabler:users',
                    },
                    {
                    title: 'Profesionales en restauración',
                    description: 'Profesionales ambientales que trabajan o tienen interés en la restauración de ecosistemas degradados como herramienta para la conservación de la naturaleza.',
                    icon: 'tabler:leaf',
                    },           
            ]}
            image={{
                src: '~/assets/images/maestrias/fvi-quienes-deben-asistir-msc-rat.jpg',
                alt: '¿Quiénes deben asistir a la Maestría en Rehabilitación Ambiental Terrestre?',
            }}
        >
            <Fragment slot="content">
            <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
                ¿Quiénes deben asistir?
            </h3>
            </Fragment>
        </Content>
        {/* ¿Qué vas a aprender? */}
        <Content
            items={[
            {
                title: 'Herramientas para proyectos',
                description: 'Brindar al alumno las herramientas necesarias para desarrollar proyectos de rehabilitación terrestre en medios degradados, aplicando métodos y técnicas adecuados a cada situación y condición.',
                icon: 'tabler:tools',
            },
            {
                title: 'Soluciones y potencial',
                description: 'Comprender las opciones y el potencial de las soluciones de rehabilitación ambiental en entornos naturales y construidos.',
                icon: 'tabler:eye',
            },
            {
                title: 'Integración teórico-práctica',
                description: 'Ser capaces de integrar teorías y métodos que permitan plantear, analizar y proponer proyectos de restauración ecológica de manera exitosa.',
                icon: 'tabler:book',
            },

            ]}
            image={{
            src: '~/assets/images/maestrias/fvi-que-vas-aprender-msc-mars.webp',
            alt: '¿Qué vas a aprender en la Maestría en Rehabilitación Ambiental Terrestre?',
            }}
        >
            <Fragment slot="content">
            <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
                ¿Qué vas a aprender?
            </h3>
            </Fragment>
        </Content>

        {/* 3. COLABORAN */}
        <HeroSection
            id="colaboran"
            tagline="Colaboran"
            title='Entidades Colaboradoras'
            image={{
                src: '~/assets/images/maestrias/fvi-colaboran-msc-ppet.jpg',
                alt: 'Entidades colaboradoras de la Maestría en Rehabilitación Ambiental Terrestre',
            }}
        >
            <Fragment slot="bg">
                <div class="absolute inset-0 bg-blue-50 dark:bg-pageDark"></div>
            </Fragment>
        </HeroSection>

        {/* 4. ESTRUCTURA DEL PROGRAMA */}
        <HeroSection
            id="estructura"
            tagline="Estructura"
            title='Estructura del Programa'
            subtitle='La <span class="text-primary font-semibold"> Maestría en</span> <span class="text-secondary font-semibold">Paisaje, Patrimonio y Estudios Territoriales</span> tiene una duración de <strong>seis trimestres (2 años)</strong> con un total de <strong>1,440 horas lectivas (90 créditos)</strong>. Su plan de estudios está compuesto de una secuencia básica de tres trimestres donde se imparten nueve cursos diseñados para dar una sólida formación en las áreas centrales del programa. Durante el cuarto y quinto trimestre, el alumno desarrolla su <strong>Proyecto Terminal de Maestría</strong> - <strong>PTM</strong>; posteriormente en el sexto trimestre, el alumno deberá acreditar la opción terminal de titulación y realizar sus trámites de graduación de acuerdo a la modalidad que haya elegido.'
        >
            <Fragment slot="content">
                <ProgramCurriculum courses={rehabilitacionAmbientalTerrestreCurriculum.courses} />
            </Fragment>
        </HeroSection>

        {/* 5. PROYECTO PTM (commond) */}
        <ProjectPTM />

        {/* 6. COMO SE ESTUDIA (commond) */}
        <HowToStudy />

        {/* 7. CLAUSTRO */}
        <ClaustroInfo />
        {
            facultyList.map((prof) => (
            <FacultyMember {...prof}>
                <Fragment slot="bg">
                <div class="absolute inset-0 bg-blue-50 dark:bg-pageDark" />
                </Fragment>
            </FacultyMember>
            ))
        }

        {/* 8. BENEFICIOS */}
        <Features
            id="beneficios"
            tagline='Beneficios'
            title="¿Cómo te beneficiará este programa?"
            subtitle='El egresado de la <span class="text-primary font-semibold"> Maestría en</span> <span class="text-secondary font-semibold">Rehabilitación Ambiental Terrestre</span>, será capaz de:'
            columns={2}
            items={[
                {
                    title: 'Fundamentos ecosistémicos',
                    description: 'Conocer los fundamentos teóricos del funcionamiento, estructura y dinámica de un ecosistema.',
                    icon: 'tabler:layers-linked',
                },
                {
                    title: 'Biodiversidad e interrelaciones',
                    description: 'Conocer y valorar la diversidad e interpretar las interrelaciones entre factores ambientales y procesos ecológicos, y su importancia para la conservación y ordenación de la biodiversidad y recursos.',
                    icon: 'tabler:leaf',
                },
                {
                    title: 'Interacción humano-medio',
                    description: 'Comprender los procesos de interacción entre el hombre y el medio que generan y mantienen los paisajes.',
                    icon: 'tabler:users',
                },
                {
                    title: 'Suelos y conservación',
                    description: 'Evaluar la fertilidad y la capacidad de uso de los suelos y diseñar prácticas de conservación de los mismos.',
                    icon: 'tabler:map',
                },
                {
                    title: 'Ingeniería ecológica',
                    description: 'Conocer las aplicaciones de ingeniería ecológica que potencialmente se pueden aplicar en cada caso y sus limitaciones.',
                    icon: 'tabler:tools',
                },
                {
                    title: 'Técnicas y metodologías',
                    description: 'Manejar las técnicas y metodologías de restauración aplicables a distintos niveles de organización, desde el organismo hasta el ecosistema, y en diversos ambientes.',
                    icon: 'tabler:settings',
                },
                {
                    title: 'Tecnologías ambientales',
                    description: 'Introducir tecnologías modernas y de punta orientadas a proteger el medio ambiente.',
                    icon: 'tabler:device-desktop',
                },
                {
                    title: 'Diseño de proyectos',
                    description: 'Diseñar proyectos de rehabilitación mediante varios métodos según el tipo de hábitat y las perturbaciones presentes.',
                    icon: 'tabler:layout',
                },
                {
                    title: 'Sensibilización y capacitación',
                    description: 'Sensibilizar a docentes, técnicos, miembros de ONG y comunidades en el tema de la restauración ecológica.',
                    icon: 'tabler:versions',
                },
            ]}
        />

        {/* Potencia tus salidas */}
        <Features3
            tagline='Salidas Profesionales'
            title="Potencia tus Salidas Profesionales"
            subtitle='La <span class="text-primary font-semibold"> Maestría en</span> <span class="text-secondary font-semibold">Rehabilitación Ambiental Terrestre</span>, responde a una demanda social y económica que favorezca la sostenibilidad, mejore nuestra relación con el entorno, fomentando la investigación y facilitando la inserción laboral. Las salidas profesionales, se centran claramente en:'
            columns={3}
            defaultIcon="tabler:point-filled"
            items={[
                {
                    title: 'Ámbito privado y administración',
                    description: 'Está cualificado y preparado para el ámbito privado de las consultorías ambientales, y las administraciones que gestionan el territorio y los sistemas naturales.',
                },
                {
                    title: 'Planificador y gestor de proyectos',
                    description: 'Planificador y gestor de proyectos en el campo de la restauración de ecosistemas.',
                },
                {
                    title: 'Consultor de estudios y modelos',
                    description: 'Consultor para la realización de estudios avanzados y modelos relacionados con el diagnóstico, conservación y gestión medioambiental.',
                },
                {
                    title: 'Investigador en ecología y restauración',
                    description: 'Investigador en aspectos de ecología y funcionamiento de ecosistemas, principios de restauración y rehabilitación ambiental, preparación y evaluación de proyectos y casos de estudio nacionales e internacionales.',
                },
                {
                    title: 'Asesor institucional',
                    description: 'Asesor de organismos que tienen como objetivo introducir la Restauración Ecológica como una nueva herramienta de gestión ambiental.',
                },
                {
                    title: 'Jefe de proyectos técnicos',
                    description: 'Jefe de proyectos técnicos de restauración que se ajustan a los criterios establecidos por la Society of Ecological Restoration.',
                },
                {
                    title: 'Investigador o docente público',
                    description: 'Investigador o profesor en organismos públicos de investigación y universidades.',
                },
                {
                    title: 'Personal en empresas privadas',
                    description: 'Personal en empresas privadas que trabajan en la gestión de recursos naturales, conservación y restauración de ecosistemas.',
                },
                {
                    title: 'Evaluador de estrategias y proyectos',
                    description: 'Evaluador calificado de estrategias, programas, proyectos y acciones públicas o privadas, identificando, previendo, monitoreando o evaluando sus consecuencias sobre el ecosistema en distintas escalas temporales y espaciales.',
                },
                {
                    title: 'Técnico de campo especializado',
                    description: 'Técnico especializado para desarrollar estudios de campo en medios terrestres.',
                },
            ]}
        />

        {/* Más allá del Programa - Pasantía Técnica Internacional (commond) */}
        <BeyondTheProgram />

        {/* 9. TITULACIÓN */}
        <HeroSection
            id="titulacion"
            tagline="titulacion"
            title='Evaluación y Titulación'
        >
            <Fragment slot="bg">
                <div class="absolute inset-0 bg-blue-50 dark:bg-pageDark"></div>
            </Fragment>
            <Fragment slot="content">
                <h3 class="text-left text-xl font-bold tracking-tight text-primary dark:text-accent sm:text-2xl mb-4">Evaluación</h3>
                <p class="text-left">La evaluación es continua durante todo el período lectivo e incluye, según corresponda, participación en foros, trabajos escritos y cuestionarios por módulo. Además, cada participante debe desarrollar individualmente un <strong>Proyecto Terminal de Maestría</strong>, tutorizado por un experto y <strong>presentado y defendido ante un tribunal</strong>.</p>

                <h3 class="text-left text-xl font-bold tracking-tight text-primary dark:text-accent sm:text-2xl mt-6 mb-4">Titulación</h3>
                <p class="text-left mt-6 mb-8">Los participantes que hayan superado con éxito todas las materias y contenidos básicos, así como el <strong>Proyecto Terminal de Maestría</strong> obtendrán el grado de maestría.<br><br>Título de <span class="text-primary font-semibold"> Maestría en</span> <span class="text-secondary font-semibold">Rehabilitación Ambiental Terrestre</span>, expedido por la <strong>Universidad Centro Panamericano de Estudios Superiores</strong>, Estudios con Reconocimiento de Validez Oficial - Acuerdo de Incorporación <span class="text-primary font-semibold">N° MAES180409</span>, Dirección de Educación Superior - Secretaría de Educación Pública.</p>
            
                {/* Diploma */}
                <Degree
                    degreeName="Maestría en Rehabilitación Ambiental Terrestre"
                    incorporationNumber="MAES180409"
                />
                <p class="text-sm text-left mt-6 mb-8"><span class="italic">Desde México se realiza el proceso de apostillado por la Haya y la legitimación de firmas para que no tenga problemas a la hora de presentar los títulos en un país fuera de México</span>.</p>
            </Fragment>
        </HeroSection>

        {/* 10. POST MAESTRÍA (commond) */}
        <PostMaestria />

        {/* 11. BECAS (commond) */}
        <Scholarship />

        {/* 12. COMO APLICAR (commond) */}
        <HowToApply />

        {/* 13. INSCRIPCIÓN (commond) */}
        <Registration />

        {/* 14. MEDIOS DE PAGO (commond) */}
        <PaymentMethods />

        {/* 15. SOLICITUDES (commond) */}
        <Requests />

        </div>
    </div>
    <!-- END Desktop Sidebar & Mobile Floating Pill -->
</Layout>
