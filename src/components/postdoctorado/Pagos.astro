---
import Features2 from '~/components/widgets/Features2.astro';
import { Icon } from 'astro-icon/components';
import Alert from '~/components/ui/Alert.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import PayPalHostedButtons from '~/components/common/PayPalHostedButtons.astro';
---

<!-- 12. Pagos ***************************************** --><!-- Transferencia & Giro -->
<Features2
  id="pagos"
  tagline="Pagos"
  title="Medios de Pago"
  subtitle="La matrícula puede abonarse mediante diferentes medios de pago. A continuación se detallan las opciones disponibles:"
  columns={2}
  items={[
    {
      title: '(1) Vía Transferencia a nuestra cuenta bancaria',
      description: `
              <div class="space-y-4">           
                  <p class="font-bold border-b border-primary/20 pb-1 mb-2 text-primary uppercase tracking-wider">Datos de la cuenta en soles</p>
                  <ul class="space-y-1">
                    <li><strong>Titular de la cuenta:</strong> Fondo Verde</li>
                    <li><strong>Nombre del Banco:</strong> Interbank</li>
                    <li><strong>Localidad:</strong> La Merced, Chanchamayo, Junín</li>
                    <li><strong>Nº de Cuenta Corriente S/:</strong> 546-300158759-0</li>
                    <li><strong>Código SWIFT:</strong> BINPPEPL</li>
                    <li><strong>CCI (Código Cuenta Interbancaria):</strong> 003-546-003001587590-96</li>
                  </ul>            
                  <p class="font-bold border-b border-primary/20 pb-1 mb-2 text-primary uppercase tracking-wider">Datos de la cuenta en dólares</p>
                  <ul class="space-y-1">
                    <li><strong>Titular de la cuenta:</strong> Fondo Verde</li>
                    <li><strong>Nombre del Banco:</strong> Interbank</li>
                    <li><strong>Localidad:</strong> La Merced, Chanchamayo, Junín</li>
                    <li><strong>Nº de Cuenta Corriente US$:</strong> 546-3001611473</li>
                    <li><strong>Código SWIFT:</strong> BINPPEPL</li>
                    <li><strong>CCI (Código Cuenta Interbancaria):</strong> 003-546-003001611473-95</li>
                  </ul>            
              </div>
            `,
      icon: 'tabler:cash-banknote-plus',
    },
    {
      title: '(2) Vía Giro Postal',
      description:
        'Por medio de un envío a través de <strong>WESTERN UNION / MONEY GRAM</strong>. Por favor consulte esta opción a través del correo <strong>postdoc@fondoverde.org</strong>, y le facilitaremos los datos para efectuar el pago.',
      icon: 'tabler:cash-banknote-plus',
    },
  ]}
/>
<!-- PayPal -->
<WidgetWrapper>
  <div
    class="relative flex flex-col rounded-lg border border-[#ffffff29] bg-white p-6 shadow-[0_4px_30px_rgba(0,0,0,0.1)] backdrop-blur dark:bg-pageDark dark:shadow-[0_4px_30px_rgba(0,0,0,0.1)]"
  >
    <div class="flex items-center gap-3 text-xl font-bold">
      <Icon name="tabler:brand-paypal" class="h-10 w-10 text-primary" />
      (3) Vía PayPal
    </div>
    <div class="mt-2 text-muted">
      <div class="space-y-6 text-left">
        <p class="mb-6 text-base">
          Elija el monto de inscripción y haga click en el botón "Pagar con PayPal" y serás redirigido directamente al
          sitio web de PayPal para finalizar tu compra.
        </p>

        <Alert variant="warning" title="Atención" classes={{ container: 'md:p-5' }}>
          Los montos incluyen las comisiones de pago con las que se queda PayPal.
        </Alert>

        <PayPalHostedButtons
          buttons={[
            { title: 'Modalidad Intensivo', hostedButtonId: 'HTBGKXCAUCJNA' },
            { title: 'Modalidad Flexible', hostedButtonId: '6R3MM7KRU26ZJ' },
          ]}
        />

        <Alert variant="info" title="Nota" classes={{ container: 'mb-6 md:p-5' }}>
          El medio de pago será seleccionado por el participante luego de recibir por correo electrónico la notificación
          de "<strong>Formalización de matrícula y ficha de pago</strong>"
        </Alert>
      </div>
    </div>
  </div>
</WidgetWrapper>
<!-- Fin PAGOS ************************************ -->
