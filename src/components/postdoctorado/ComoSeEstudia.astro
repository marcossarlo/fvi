---
import Content from '~/components/widgets/Content.astro';
import HeroSection from '../widgets/HeroSection.astro';
import ModeloEducativoDiagram from '../common/ModeloEducativoDiagram.astro';
---

<!-- 6. ¿Cómo se estudia? ****************************** -->
       {/* ¿Cómo se estudia? */}
      <Content
        id="como-se-estudia"
        tagline="¿Cómo se estudia?"
        title="Nuestro Campus Virtual"
        content='Todos nuestros programas se desarrollan a través del <strong>Campus Virtual</strong> de <strong>Fondo Verde</strong> (<a href="https://www.fondoverdeopen.net/" target="_blank" rel="noopener noreferrer" class="text-primary hover:text-secondary underline underline-offset-2">fondoverdeopen.net</a>), que permite la interacción profesor-tutor y de los participantes entre sí.'
        isReversed
        items={[
          {
            title: 'Plataforma multimedia',
            description:
              'Una plataforma multimedia que gracias a tecnologías de última generación permite participar desde ubicaciones remotas y brindar acceso instantáneo al mejor contenido.',
            icon: 'tabler:device-laptop',
          },
          {
            title: 'Recursos didácticos',
            description:
              'Contenidos del programa formativo, disponibles en todo momento a través del campus virtual en formato de libro electrónico, casos prácticos, vídeos y otros recursos didácticos.',
            icon: 'tabler:video',
          },
          {
            title: 'Interacción y acompañamiento',
            description:
              'A través de los diferentes canales de chat, foros y servicios de mensajería podrá contactar con otros alumnos y realizar tantas consultas a su tutor como estime necesario.',
            icon: 'tabler:messages',
          },
        ]}
        image={{
          src: '~/assets/images/fvi-nuestro-campus-FV.webp',
          alt: 'Estudio online en campus virtual de Fondo Verde',
        }}
      />
      {/* Modelo Educativo */}
      <HeroSection
          title='Modelo Educativo'
          subtitle='El <strong>Postdoctorado</strong> combina los cursos teóricos, seminarios de investigación, actividades auxiliares, tutoría y el proyecto postdoctoral. La especial conjunción de estos elementos, orientada a lograr el máximo aprovechamiento tanto académico como personal del postdoctorando constituye el verdadero elemento diferenciador y de valor añadido de Fondo Verde con respecto a otras instituciones.'
      >
          <Fragment slot="content">
              <p class="text-base">Los recursos metodológicos de los que el Instituto dispone para la impartición de sus programas fundamentalmente son:</p>
              
              <ModeloEducativoDiagram
                centerLabel="PostDOC"
                    nodes={[
                        { title: "Cursos teóricos", description: "Fomentan la colaboración transnacional en muy diferentes campos de estudio e impartidos por personal docente e investigador y por expertos con un perfil internacional." , titleClass: 'text-primary',},
                        { title: "Seminarios de Investigación", description: "Seminarios prácticos de seguimiento a su investigación relacionados a la problemática ambiental elegida.", titleClass: 'text-primary', },
                        { title: "Tareas Postdoctorales", description: "Realización de actividades auxiliares con el objeto de contribuir en las investigaciones de los postdoctorandos.", titleClass: 'text-primary', },
                        { title: "Tutoría académica", description: "El tutor tendrá como función facilitar la integración del postdoctorando durante su formación académica, orientarle en su investigación y coordinar su participación en actividades auxiliares.", titleClass: 'text-primary', },
                        { title: "Proyecto Postdoctoral", description: "La temática del proyecto de investigación debe representar un avance en el conocimiento del área elegida, procurando alcanzar el más alto nivel internacional.", titleClass: 'text-primary', }
                    ]}
                />

          </Fragment>

      </HeroSection>
      <!-- Fin ¿CÓMO SE ESTUDIA? ************************************ -->
