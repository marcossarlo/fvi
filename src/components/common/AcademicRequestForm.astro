---
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

export interface Props {
  program: string;
  programs: string[];
  programLabel: string;
  formPrefix: string;
  recipientEmail?: string;
  whatsappNumber?: string;
  endpoint?: string;
}

const {
  program,
  programs,
  programLabel,
  formPrefix,
  recipientEmail = 'yessenia.quispe@fondoverde.org',
  whatsappNumber = '51935544232',
  endpoint,
} = Astro.props;

const selectedProgram = programs.includes(program) ? program : programs[0];
const whatsappId = `${formPrefix}-whatsapp`;
const programSelectId = `${formPrefix}-program-interest`;

const createWhatsAppUrl = (programName: string) => {
  const message = `Hola, Yessenia. Me gustaría recibir información sobre ${programName}, especialmente sobre requisitos de admisión, duración y opciones de pago. Gracias.`;
  return `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
};
---

<WidgetWrapper id="solicitudes" containerClass="max-w-7xl mx-auto px-4 py-10 sm:px-6 md:py-16 md:pb-16">
  <Headline
    tagline="Solicitudes"
    title="¿Tienes dudas o quieres matricularte?"
    subtitle="Solicita asesoría personalizada o inicia tu proceso de admisión directamente con nuestra área de Posgrado."
    classes={{ container: 'max-w-4xl mb-10 md:mb-12', title: 'text-3xl md:text-4xl', subtitle: 'text-base md:text-lg' }}
  />

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(280px,0.8fr)_minmax(0,1.2fr)] lg:gap-8">
    <aside
      class="flex min-w-0 flex-col rounded-2xl border border-slate-200 bg-slate-50/80 p-5 dark:border-slate-700 dark:bg-slate-900/50 sm:p-7"
    >
      <div class="flex flex-col items-center text-center">
        <div class="relative h-52 w-52 shrink-0">
          <Image
            src="~/assets/images/users/fvi-yessenia-quispe.webp"
            alt="Yessenia Quispe Aquino, responsable de admisiones"
            width={400}
            height={400}
            class="h-full w-full rounded-2xl border-2 border-teal-500 object-cover"
          />
          <span class="absolute -bottom-1 -right-1 flex h-5 w-5" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500 opacity-75"></span>
            <span
              class="relative inline-flex h-5 w-5 rounded-full border-[3px] border-slate-50 bg-emerald-500 dark:border-slate-900"
            ></span>
          </span>
        </div>
        <h3 class="mt-4 text-lg font-bold leading-tight text-slate-900 dark:text-white">Yessenia Quispe Aquino</h3>
        <p class="mt-1 text-xs font-bold uppercase tracking-wide text-teal-700 dark:text-teal-300">
          Responsable de admisiones
        </p>
      </div>

      <blockquote
        class="mt-5 rounded-xl border border-slate-200 bg-white px-4 py-4 text-sm leading-relaxed text-slate-700 dark:border-slate-700 dark:bg-pageDark dark:text-slate-200"
      >
        “Te acompaño paso a paso en tu postulación, evaluación de perfil y proceso de matriculación.”
      </blockquote>

      <div class="mt-5 grid gap-3">
        <a
          id={whatsappId}
          href={createWhatsAppUrl(selectedProgram)}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex min-h-16 items-center gap-3 rounded-xl border border-emerald-200 bg-emerald-50 px-3.5 py-3 text-emerald-900 transition-colors duration-300 hover:border-emerald-300 hover:bg-emerald-100 active:scale-[0.99] dark:border-emerald-900 dark:bg-emerald-950/40 dark:text-emerald-100 dark:hover:bg-emerald-950/70"
        >
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-emerald-500 text-white">
            <Icon name="tabler:brand-whatsapp" class="h-6 w-6" aria-hidden="true" />
          </span>
          <span class="min-w-0 flex-1">
            <span class="block text-[0.68rem] font-bold uppercase tracking-wider">WhatsApp directo</span>
            <span class="mt-0.5 block text-sm font-bold">+51 935 544 232</span>
          </span>
          <Icon
            name="tabler:arrow-right"
            class="h-5 w-5 shrink-0 transition-transform duration-300 group-hover:translate-x-1"
            aria-hidden="true"
          />
        </a>

        <a
          href={`mailto:${recipientEmail}`}
          class="flex min-h-16 items-center gap-3 rounded-xl border border-slate-200 bg-white px-3.5 py-3 text-slate-700 transition-colors duration-300 hover:border-teal-300 hover:bg-teal-50/50 active:scale-[0.99] dark:border-slate-700 dark:bg-pageDark dark:text-slate-200 dark:hover:border-teal-800 dark:hover:bg-slate-800"
        >
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-teal-500 text-white">
            <Icon name="tabler:mail" class="h-5 w-5" aria-hidden="true" />
          </span>
          <span class="min-w-0 flex-1">
            <span class="block text-[0.68rem] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
              Correo electrónico
            </span>
            <span class="mt-0.5 block truncate text-sm font-semibold">{recipientEmail}</span>
          </span>
          <Icon name="tabler:copy" class="h-4 w-4 shrink-0 text-slate-400" aria-hidden="true" />
        </a>
      </div>
    </aside>

    <div class="min-w-0 py-1 lg:py-0">
      <div
        class="mb-5 flex items-start gap-2.5 rounded-xl border border-teal-200 bg-teal-50/70 px-4 py-3 text-sm text-slate-700 dark:border-teal-900 dark:bg-teal-950/30 dark:text-slate-200"
      >
        <Icon
          name="tabler:info-circle-filled"
          class="mt-0.5 h-4 w-4 shrink-0 text-teal-600 dark:text-teal-400"
          aria-hidden="true"
        />
        <label for={programSelectId} class="min-w-0 flex-1 leading-relaxed">
          Solicitando información para:
          <select
            id={programSelectId}
            name="program"
            required
            class="mt-1 block w-full cursor-pointer border-0 bg-transparent p-0 pr-7 text-sm font-bold text-teal-800 outline-none focus:ring-0 dark:text-teal-300"
            aria-label={`Programa de ${programLabel} de interés`}
          >
            {
              programs.map((programOption) => (
                <option value={programOption} selected={selectedProgram === programOption}>
                  {programOption}
                </option>
              ))
            }
          </select>
        </label>
      </div>

      <form
        class="space-y-4"
        action={endpoint}
        method={endpoint ? 'post' : undefined}
        data-academic-request-form
        data-academic-prefix={formPrefix}
        data-whatsapp-number={whatsappNumber}
      >
        <div>
          <label
            for={`${formPrefix}-name`}
            class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-700 dark:text-slate-200"
          >
            Nombre y apellidos <span class="text-rose-600" aria-hidden="true">*</span>
          </label>
          <input
            id={`${formPrefix}-name`}
            name="name"
            type="text"
            autocomplete="name"
            placeholder="Ej. Carlos Mendoza Ramos"
            required
            class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 dark:border-slate-600 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500"
          />
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label
              for={`${formPrefix}-email`}
              class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-700 dark:text-slate-200"
            >
              Correo electrónico <span class="text-rose-600" aria-hidden="true">*</span>
            </label>
            <input
              id={`${formPrefix}-email`}
              name="email"
              type="email"
              autocomplete="email"
              placeholder="carlos@ejemplo.com"
              required
              class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 dark:border-slate-600 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500"
            />
          </div>
          <div>
            <label
              for={`${formPrefix}-objective`}
              class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-700 dark:text-slate-200"
            >
              Motivo de la consulta <span class="text-rose-600" aria-hidden="true">*</span>
            </label>
            <select
              id={`${formPrefix}-objective`}
              name="objective"
              required
              class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 dark:border-slate-600 dark:bg-slate-900 dark:text-white"
            >
              <option value="plan-estudios-costos">Solicitar plan de estudios y costos</option>
              <option value="requisitos">Conocer requisitos de admisión</option>
              <option value="becas-pagos">Consultar sobre becas y opciones de pago</option>
              <option value="asesoria">Solicitar asesoría personalizada</option>
              <option value="otros">Realizar otra consulta</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label
              for={`${formPrefix}-country`}
              class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-700 dark:text-slate-200"
            >
              País de residencia
            </label>
            <select
              id={`${formPrefix}-country`}
              name="country"
              class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 dark:border-slate-600 dark:bg-slate-900 dark:text-white"
            >
              <optgroup label="América del Norte">
                <option value="México" data-calling-code="+52">México (+52)</option>
              </optgroup>
              <optgroup label="Centroamérica">
                <option value="Costa Rica" data-calling-code="+506">Costa Rica (+506)</option>
                <option value="El Salvador" data-calling-code="+503">El Salvador (+503)</option>
                <option value="Honduras" data-calling-code="+504">Honduras (+504)</option>
                <option value="Panamá" data-calling-code="+507">Panamá (+507)</option>
              </optgroup>
              <optgroup label="Caribe">
                <option value="República Dominicana" data-calling-code="+1"> República Dominicana (+1) </option>
              </optgroup>
              <optgroup label="América del Sur">
                <option value="Argentina" data-calling-code="+54">Argentina (+54)</option>
                <option value="Bolivia" data-calling-code="+591">Bolivia (+591)</option>
                <option value="Chile" data-calling-code="+56">Chile (+56)</option>
                <option value="Colombia" data-calling-code="+57">Colombia (+57)</option>
                <option value="Ecuador" data-calling-code="+593">Ecuador (+593)</option>
                <option value="Paraguay" data-calling-code="+595">Paraguay (+595)</option>
                <option value="Perú" data-calling-code="+51" selected>Perú (+51)</option>
                <option value="Venezuela" data-calling-code="+58">Venezuela (+58)</option>
              </optgroup>
              <optgroup label="Europa">
                <option value="España" data-calling-code="+34">España (+34)</option>
              </optgroup>
              <option value="Otro país" data-calling-code="">Otro país</option>
            </select>
          </div>
          <div>
            <label
              for={`${formPrefix}-phone`}
              class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-700 dark:text-slate-200"
            >
              WhatsApp / teléfono <span class="text-rose-600" aria-hidden="true">*</span>
            </label>
            <div
              class="flex w-full overflow-hidden rounded-xl border border-slate-300 bg-slate-50 transition focus-within:border-teal-500 focus-within:ring-2 focus-within:ring-teal-500/20 dark:border-slate-600 dark:bg-slate-900"
            >
              <input
                id={`${formPrefix}-country-code`}
                name="phone_country_code"
                type="tel"
                inputmode="tel"
                autocomplete="tel-country-code"
                aria-label="Código telefónico internacional"
                required
                maxlength="5"
                value="+51"
                class="w-20 shrink-0 border-0 border-r border-slate-300 bg-transparent px-4 py-3 text-sm font-semibold text-slate-700 outline-none focus:ring-0 dark:border-slate-600 dark:text-slate-200"
              />
              <input
                id={`${formPrefix}-phone`}
                name="phone"
                type="tel"
                inputmode="tel"
                autocomplete="tel-national"
                aria-label="Número de teléfono"
                placeholder="987 654 321"
                required
                class="min-w-0 flex-1 border-0 bg-transparent px-4 py-3 text-sm text-slate-900 outline-none focus:ring-0 dark:text-white dark:placeholder:text-slate-500"
              />
            </div>
          </div>
        </div>

        <div>
          <label
            for={`${formPrefix}-message`}
            class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-700 dark:text-slate-200"
          >
            Mensaje o consulta específica <span class="font-normal text-slate-400">(opcional)</span>
          </label>
          <textarea
            id={`${formPrefix}-message`}
            name="message"
            rows="3"
            placeholder="Escribe aquí si tienes dudas sobre requisitos de titulación, métodos de pago o fechas..."
            class="w-full resize-y rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 dark:border-slate-600 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500"
          ></textarea>
        </div>

        <label
          for={`${formPrefix}-privacy`}
          class="flex cursor-pointer items-start gap-2.5 text-xs leading-relaxed text-slate-500 dark:text-slate-400"
        >
          <input
            id={`${formPrefix}-privacy`}
            name="privacy"
            type="checkbox"
            required
            class="mt-0.5 h-4 w-4 shrink-0 rounded border-slate-300 text-teal-600 focus:ring-teal-500"
          />
          <span
            >Acepto la política de privacidad para el tratamiento de mis datos de contacto con fines académicos de Fondo
            Verde.</span
          >
        </label>

        <button
          type={endpoint ? 'submit' : 'button'}
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-teal-600 px-5 py-3.5 text-sm font-bold text-white shadow-[0_10px_18px_-12px_rgba(13,148,136,0.7)] transition duration-300 hover:bg-teal-700 active:scale-[0.99] focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-500 focus-visible:ring-offset-2 dark:bg-teal-500 dark:hover:bg-teal-400"
        >
          Enviar solicitud de información
          <Icon name="tabler:arrow-right" class="h-5 w-5" aria-hidden="true" />
        </button>
      </form>
    </div>
  </div>

  <Fragment slot="bg">
    <div class="absolute inset-0 bg-blue-50 dark:bg-pageDark"></div>
  </Fragment>

  <script>
    document.querySelectorAll<HTMLFormElement>('[data-academic-request-form]').forEach((form) => {
      const prefix = form.dataset.academicPrefix;
      if (!prefix) return;

      const programSelect = document.querySelector<HTMLSelectElement>(`#${prefix}-program-interest`);
      const whatsappLink = document.querySelector<HTMLAnchorElement>(`#${prefix}-whatsapp`);
      const countrySelect = form.querySelector<HTMLSelectElement>(`#${prefix}-country`);
      const countryCodeInput = form.querySelector<HTMLInputElement>(`#${prefix}-country-code`);
      const phoneInput = form.querySelector<HTMLInputElement>(`#${prefix}-phone`);
      const whatsappNumber = form.dataset.whatsappNumber;

      if (countrySelect && countryCodeInput && phoneInput) {
        countrySelect.addEventListener('change', () => {
          countryCodeInput.value = countrySelect.selectedOptions[0]?.dataset.callingCode ?? '';
          phoneInput.focus();
        });
      }

      if (programSelect && whatsappLink) {
        programSelect.addEventListener('change', () => {
          const message = `Hola, Yessenia. Me gustaría recibir información sobre ${programSelect.value}, especialmente sobre requisitos de admisión, duración y opciones de pago. Gracias.`;
          whatsappLink.href = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
        });
      }
    });
  </script>
</WidgetWrapper>
