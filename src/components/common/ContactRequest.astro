---
import { Icon } from 'astro-icon/components';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

export interface Props {
  initialArea?: string;
  endpoint?: string;
}

const { initialArea = 'general', endpoint } = Astro.props;

const areas = [
  { value: 'general', label: 'Consultas generales', email: 'info@fondoverde.org' },
  { value: 'alianza', label: 'Alianzas empresariales', email: 'info@fondoverde.org' },
  { value: 'licencias', label: 'Licencias institucionales', email: 'info@fondoverde.org' },
  { value: 'becas', label: 'Becas', email: 'scholarships@fondoverde.org' },
  { value: 'doctorado', label: 'Doctorados', email: 'doctorados@fondoverde.org' },
  { value: 'maestria', label: 'Maestrías', email: 'maestrias@fondoverde.org' },
  { value: 'postdoctorado', label: 'Posdoctorados', email: 'postdoc@fondoverde.org' },
];

const selectedArea = areas.some((area) => area.value === initialArea) ? initialArea : 'general';
---

<WidgetWrapper id="formulario-contacto" containerClass="max-w-7xl mx-auto px-4 py-10 sm:px-6 md:py-16">
  <Headline
    title="Envía tu consulta"
    subtitle="Selecciona el área correspondiente para que podamos dirigirte con el equipo adecuado."
    classes={{ container: 'max-w-3xl mb-8 md:mb-10' }}
  />

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(240px,0.7fr)_minmax(0,1.3fr)]">
    <aside class="grid content-start gap-3">
      <a
        href="mailto:info@fondoverde.org"
        class="flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 px-4 py-4 text-slate-700 transition hover:border-teal-300 hover:bg-teal-50 dark:border-slate-700 dark:bg-slate-900/50 dark:text-slate-200"
      >
        <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-teal-500 text-white">
          <Icon name="tabler:mail" class="h-5 w-5" />
        </span>
        <span>
          <span class="block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400"
            >Correo general</span
          >
          <span class="block text-sm font-bold">info@fondoverde.org</span>
        </span>
      </a>

      <a
        href="https://wa.me/51935544232"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-3 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-4 text-emerald-900 transition hover:bg-emerald-100 dark:border-emerald-900 dark:bg-emerald-950/40 dark:text-emerald-100"
      >
        <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500 text-white">
          <Icon name="tabler:brand-whatsapp" class="h-6 w-6" />
        </span>
        <span>
          <span class="block text-xs font-bold uppercase tracking-wide">WhatsApp</span>
          <span class="block text-sm font-bold">+51 935 544 232</span>
        </span>
      </a>
    </aside>

    <div
      class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-pageDark sm:p-7"
    >
      <form class="space-y-4" action={endpoint} method={endpoint ? 'post' : undefined} data-contact-form>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label
              for="contact-name"
              class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-700 dark:text-slate-200"
            >
              Nombre y apellidos <span class="text-rose-600">*</span>
            </label>
            <input
              id="contact-name"
              name="name"
              type="text"
              autocomplete="name"
              required
              maxlength="100"
              placeholder="Ej. María Pérez"
              class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 dark:border-slate-600 dark:bg-slate-900 dark:text-white"
            />
          </div>
          <div>
            <label
              for="contact-email"
              class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-700 dark:text-slate-200"
            >
              Correo electrónico <span class="text-rose-600">*</span>
            </label>
            <input
              id="contact-email"
              name="email"
              type="email"
              autocomplete="email"
              required
              maxlength="160"
              placeholder="maria@ejemplo.com"
              class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 dark:border-slate-600 dark:bg-slate-900 dark:text-white"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label
              for="contact-area"
              class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-700 dark:text-slate-200"
            >
              Área de consulta <span class="text-rose-600">*</span>
            </label>
            <select
              id="contact-area"
              name="area"
              required
              class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 dark:border-slate-600 dark:bg-slate-900 dark:text-white"
            >
              {
                areas.map((area) => (
                  <option value={area.value} selected={selectedArea === area.value}>
                    {area.label}
                  </option>
                ))
              }
            </select>
          </div>
          <div>
            <label
              for="contact-phone"
              class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-700 dark:text-slate-200"
            >
              WhatsApp / teléfono
            </label>
            <input
              id="contact-phone"
              name="phone"
              type="tel"
              autocomplete="tel"
              maxlength="40"
              placeholder="+51 987 654 321"
              class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 dark:border-slate-600 dark:bg-slate-900 dark:text-white"
            />
          </div>
        </div>

        <div>
          <label
            for="contact-message"
            class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-700 dark:text-slate-200"
          >
            Mensaje <span class="text-rose-600">*</span>
          </label>
          <textarea
            id="contact-message"
            name="message"
            required
            minlength="10"
            maxlength="3000"
            rows="5"
            placeholder="Cuéntanos cómo podemos ayudarte..."
            class="w-full resize-y rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 dark:border-slate-600 dark:bg-slate-900 dark:text-white"
          ></textarea>
        </div>

        <label
          for="contact-privacy"
          class="flex cursor-pointer items-start gap-2.5 text-xs leading-relaxed text-slate-500 dark:text-slate-400"
        >
          <input
            id="contact-privacy"
            name="privacy"
            type="checkbox"
            required
            class="mt-0.5 h-4 w-4 shrink-0 rounded border-slate-300 text-teal-600 focus:ring-teal-500"
          />
          <span
            >Acepto la política de privacidad para el tratamiento de mis datos con fines de atención de consultas.</span
          >
        </label>

        <button
          type={endpoint ? 'submit' : 'button'}
          disabled={!endpoint}
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-teal-600 px-5 py-3.5 text-sm font-bold text-white shadow-[0_10px_18px_-12px_rgba(13,148,136,0.7)] transition hover:bg-teal-700 disabled:cursor-not-allowed disabled:opacity-60"
        >
          {endpoint ? 'Enviar consulta' : 'Formularios en preparación'}
          <Icon name="tabler:arrow-right" class="h-5 w-5" />
        </button>
      </form>
    </div>
  </div>

  <Fragment slot="bg">
    <div class="absolute inset-0 bg-blue-50 dark:bg-pageDark"></div>
  </Fragment>

  <script>
    const areaSelect = document.querySelector<HTMLSelectElement>('#contact-area');
    if (areaSelect) {
      const asunto = new URLSearchParams(window.location.search).get('asunto');
      const area = asunto === 'licencias' ? 'licencias' : asunto === 'alianzas' ? 'alianza' : null;

      if (area) areaSelect.value = area;
    }
  </script>
</WidgetWrapper>
