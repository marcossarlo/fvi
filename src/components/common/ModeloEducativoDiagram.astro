---
export interface NodeItem {
  title: string;
  description: string;
  titleClass?: string;
}

export interface Props {
  centerLabel?: string;
  nodes?: NodeItem[];
}

const defaultNodes = [
  {
    title: 'Cursos modulares',
    description:
      'Impartidas por profesionales en activo con amplia trayectoria que enriquecen el aprendizaje del alumno en materias técnicas o empresariales y experiencias actuales reales.',
    position: 'left-[13%] top-[13%] w-[24%]',
    titleClass: 'text-primary',
  },
  {
    title: 'Casos prácticos',
    description:
      'Durante el programa se desarrollan casos prácticos que reflejan situaciones reales, a las que se enfrentarán cuando se incorporen al mundo laboral.',
    position: 'left-[56%] top-[11%] w-[24%]',
    titleClass: 'text-primary',
  },
  {
    title: 'Evaluación continua',
    description:
      'Los participantes son evaluados a lo largo de todo el período lectivo de forma continua, para lo cual se tienen en cuenta la participación en los foros y seminarios y las actividades académicas.',
    position: 'right-[10%] top-[35%] w-[24%]',
    titleClass: 'text-primary',
  },
  {
    title: 'Tutoría académica',
    description:
      'Contactos con los docentes, para la resolución directa de dudas sobre las materias docentes y/o para atender las distintas necesidades de los alumnos.',
    position: 'left-1/2 bottom-[11%] w-[24%] -translate-x-1/2',
    titleClass: 'text-primary',
  },
  {
    title: 'Proyecto',
    description:
      'Los alumnos desarrollan de manera personal e individual un proyecto que es parte obligatoria para completar las exigencias académicas de la Maestría.',
    position: 'left-[12%] bottom-[16%] w-[24%]',
    titleClass: 'text-primary',
  },
];

const { centerLabel = 'MSc', nodes = defaultNodes } = Astro.props as Props;

const radialPositions = [
  { left: 31, top: 28 },
  { left: 66, top: 26 },
  { left: 80, top: 54 },
  { left: 50, top: 79 },
  { left: 22, top: 56 },
];
---

<div class="mx-auto mt-10 w-full max-w-5xl">
  <div class="relative hidden aspect-square overflow-hidden rounded-[2rem] border border-slate-200/80 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.96)_0%,rgba(248,250,252,0.98)_43%,rgba(241,245,249,0.9)_72%,rgba(255,255,255,1)_100%)] shadow-[0_28px_80px_rgba(15,23,42,0.10)] xl:block dark:border-slate-700/80 dark:bg-[radial-gradient(circle_at_center,rgba(15,23,42,0.98)_0%,rgba(15,23,42,0.96)_45%,rgba(3,6,32,0.98)_100%)]">
    <svg class="absolute inset-0 h-full w-full text-slate-200/80 dark:text-slate-700/70" viewBox="0 0 1000 1000" fill="none" aria-hidden="true">
      <circle cx="500" cy="500" r="320" stroke="currentColor" stroke-width="5" opacity="0.74" />
      <circle cx="500" cy="500" r="222" stroke="currentColor" stroke-width="1.5" stroke-dasharray="5 16" opacity="0.6" />
      <line x1="500" y1="500" x2="310" y2="265" stroke="currentColor" stroke-width="5" opacity="0.44" />
      <line x1="500" y1="500" x2="640" y2="210" stroke="currentColor" stroke-width="5" opacity="0.44" />
      <line x1="500" y1="500" x2="780" y2="520" stroke="currentColor" stroke-width="5" opacity="0.44" />
      <line x1="500" y1="500" x2="500" y2="770" stroke="currentColor" stroke-width="5" opacity="0.44" />
      <line x1="500" y1="500" x2="245" y2="650" stroke="currentColor" stroke-width="5" opacity="0.44" />
    </svg>

    <div class="absolute left-1/2 top-1/2 z-20 flex h-32 w-32 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-primary text-white shadow-[0_18px_40px_rgba(15,118,110,0.32)] ring-8 ring-white/90 dark:ring-slate-900/70">
      <span class="font-serif text-5xl leading-none text-white">{centerLabel}</span>
    </div>

    {nodes.map((node, index) => (
      <div
        class="absolute z-10 aspect-square h-[26%] w-[26%] -translate-x-1/2 -translate-y-1/2 rounded-full border-[10px] border-slate-400/95 bg-white p-5 text-center shadow-[0_10px_30px_rgba(15,23,42,0.08)] backdrop-blur-[1px] transition-transform duration-300 hover:scale-[1.02] dark:border-slate-500/95 dark:bg-pageDark"
        style={`left: ${radialPositions[index].left}%; top: ${radialPositions[index].top}%;`}
      >
        <div
          class="absolute inset-0 rounded-full opacity-35"
          style={{
            backgroundImage:
              'repeating-linear-gradient(45deg, rgba(148,163,184,0.26) 0, rgba(148,163,184,0.26) 1px, transparent 1px, transparent 7px)',
          }}
        />
        <div class="relative z-10 flex h-full w-full flex-col items-center justify-center px-2 text-slate-700 dark:text-slate-300">
          <h3 class={`text-[1.05rem] font-semibold leading-tight sm:text-[1.1rem] ${node.titleClass}`}>
            {node.title}
          </h3>
          <p class="mt-1 text-[0.86rem] leading-[1.28] sm:text-[0.92rem]">
            {node.description}
          </p>
        </div>
      </div>
    ))}
  </div>

  <div class="grid gap-4 xl:hidden">
    <div class="mx-auto flex h-24 w-24 items-center justify-center rounded-full bg-primary text-white shadow-[0_18px_40px_rgba(15,118,110,0.32)] ring-8 ring-white dark:ring-slate-900">
      <span class="font-serif text-3xl leading-none text-white">{centerLabel}</span>
    </div>

    {nodes.map((node) => (
      <article class="relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white/95 p-4 shadow-[0_12px_30px_rgba(15,23,42,0.06)] dark:border-slate-600/80 dark:bg-[radial-gradient(circle_at_top,rgba(15,23,42,0.98)_0%,rgba(15,23,42,0.95)_48%,rgba(3,6,32,0.98)_100%)] dark:shadow-[0_12px_28px_rgba(0,0,0,0.24)]">
        <div
          class="absolute inset-0 opacity-30 dark:opacity-25"
          style={{
            backgroundImage:
              'repeating-linear-gradient(45deg, rgba(148,163,184,0.18) 0, rgba(148,163,184,0.18) 1px, transparent 1px, transparent 7px)',
          }}
        />
        <div class="relative z-10 flex items-start gap-3 text-left">
          <span class="mt-1.5 h-2.5 w-2.5 flex-shrink-0 rounded-full bg-primary shadow-sm dark:bg-secondary" />
          <div class="flex-1 text-left">
            <h3 class="text-base font-semibold leading-tight text-primary sm:text-[1.05rem] dark:text-slate-100">{node.title}</h3>
            <p class="mt-1.5 text-[0.95rem] leading-relaxed text-slate-600 dark:text-slate-300 sm:text-base">{node.description}</p>
          </div>
        </div>
      </article>
    ))}
  </div>
</div>