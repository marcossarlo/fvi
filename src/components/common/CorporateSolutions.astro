---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import Button from '~/components/ui/Button.astro';
import Alert from '~/components/ui/Alert.astro';
---

<WidgetWrapper containerClass="max-w-7xl mx-auto pb-0 md:pb-16">
  <Headline
    title="Convenios Corporativos y Licencias B2B"
    tagline="Soluciones para Empresas e Instituciones"
  />

  <div class="grid gap-6 sm:grid-cols-2">
    
      <Alert variant="success" title="Acuerdo de Asociación (Partnership)">
        Si tu organización desea implementar nuestros programas de capacitación ambiental a medida para su personal.<br /><br />
        <Button
          text="Consultar asociaciones"
          href="/contacto"
          variant="primary"
          icon="tabler:arrow-right"
        />
      </Alert>
    
      <Alert variant="info" title="Licencias de Cursos para Instituciones">
        Condiciones de compra y cesión de derechos de contenidos académicos para universidades y entes educativos.<br /><br />
        <Button
          text="Consultar licencias"
          href="/contacto"
          variant="secondary"
          icon="tabler:arrow-right"
        />
      </Alert> 
    
  </div>
</WidgetWrapper>
