---
import AcademicRequestForm from '~/components/common/AcademicRequestForm.astro';
import CorporateSolutions from '~/components/common/CorporateSolutions.astro';

export interface Props {
  program: string;
}

const { program } = Astro.props;

const programs = [
  'Doctorado en Sostenibilidad',
  'Doctorado en Conservación y Restauración del Medio Natural',
  'Doctorado en Proyectos: Línea de Investigación en Medio Ambiente',
  'Doctorado en Administración de Negocios Sostenibles',
  'Doctorado en Educación Ambiental',
  'Doctorado en Paisaje y Ambiente',
  'Doctorado en Ecoturismo y Turismo Sostenible',
  'Doctorado en Urbanismo y Arquitectura Sostenible',
  'Doctorado en Energías Renovables',
];
---

<AcademicRequestForm program={program} programs={programs} programLabel="Doctorado" formPrefix="phd" />
<CorporateSolutions />
