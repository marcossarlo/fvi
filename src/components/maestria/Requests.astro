---
import AcademicRequestForm from '~/components/common/AcademicRequestForm.astro';
import CorporateSolutions from '~/components/common/CorporateSolutions.astro';

export interface Props {
  program: string;
}

const { program } = Astro.props;

const programs = [
  'Maestría en Rehabilitación Ambiental Terrestre',
  'Maestría en Medio Ambiente y Responsabilidad Social',
  'Maestría en Paisaje, Patrimonio y Estudios Territoriales',
  'Maestría en Hábitat, Urbanismo y Edificación Sostenible',
  'Maestría en Sostenibilidad Turística y Ecoturismo',
  'Maestría en Gestión de Proyectos Ambientales',
  'Maestría en Ciencias de la Sostenibilidad',
  'Maestría en Eficiencia Energética, Cambio Climático y Sostenibilidad',
];
---

<AcademicRequestForm program={program} programs={programs} programLabel="Maestría" formPrefix="master" />
<CorporateSolutions />
