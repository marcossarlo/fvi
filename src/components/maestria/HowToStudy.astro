---
import Content from '~/components/widgets/Content.astro';
import HeroSection from '~/components/widgets/HeroSection.astro';
import ModeloEducativoDiagram from '~/components/common/ModeloEducativoDiagram.astro';

export interface Props {
    id?: string;
}

const { id = "estudio" } = Astro.props;
---

{/* 6. COMO SE ESTUDIA (Común) */}
<Content
    id={id}
    tagline="¿Cómo se estudia?"
    title="Nuestro Campus Virtual"
    content='Todos nuestros programas se desarrollan a través del <strong>Campus Virtual</strong> de <strong>Fondo Verde</strong> (<a href="https://www.fondoverdeopen.net/" target="_blank" rel="noopener noreferrer" class="text-primary hover:text-secondary underline underline-offset-2">fondoverdeopen.net</a>), que permite la interacción profesor-tutor y de los participantes entre sí.'
    isReversed
    items={[
        {
        title: 'Plataforma multimedia',
        description:
            'Una plataforma multimedia que gracias a tecnologías de última generación permite participar desde ubicaciones remotas y brindar acceso instantáneo al mejor contenido.',
        icon: 'tabler:device-laptop',
        },
        {
        title: 'Recursos didácticos',
        description:
            'Contenidos del programa formativo, disponibles en todo momento a través del campus virtual en formato de libro electrónico, casos prácticos, vídeos y otros recursos didácticos.',
        icon: 'tabler:video',
        },
        {
        title: 'Interacción y acompañamiento',
        description:
            'A través de los diferentes canales de chat, foros y servicios de mensajería podrá contactar con otros alumnos y realizar tantas consultas a su tutor como estime necesario.',
        icon: 'tabler:messages',
        },
    ]}
    image={{
        src: '~/assets/images/fvi-nuestro-campus-FV.webp',
        alt: 'Estudio online en campus virtual de Fondo Verde',
    }}
/>

{/* Modelo Educativo */}
<HeroSection
    title='Modelo Educativo'
    subtitle='La <strong>Maestría</strong> combina los cursos modulares, casos prácticos, evaluaciones continuas, tutoría académica, y proyecto. La especial conjunción de estos elementos, orientada a lograr el máximo aprovechamiento, tanto académico como personal del alumno, constituye el verdadero elemento diferenciador y de valor añadido de <span class="text-primary font-semibold">Fondo Verde</span>, con respecto a otras instituciones.'
>
    <Fragment slot="content">
        <p class="text-base">Los recursos metodológicos de los que el Instituto dispone para la impartición de sus programas fundamentalmente son:</p>
        
        <ModeloEducativoDiagram />

    </Fragment>

</HeroSection>

{/* Recursos Materiales y Servicios */}
<HeroSection
    tagline='Recursos Materiales y Servicios'
    title='Difusión y extensión de proyectos finales de alumnos'
    subtitle='Usted puede publicar los estudios de caso y/o artículos de revista (preprints, post-prints o la versión autor corregida y ampliada, o la versión edición en función de lo que permita el editor), informes técnicos o de investigación, avances académicos de su Proyecto Terminal de Maestría - PTM.'
    image={{
        src: '~/assets/images/maestrias/fvi-recursos-materiales.webp',
        alt: 'Recursos materiales y servicios de difusión de proyectos finales de alumnos en Fondo Verde',
    }}
>
    <Fragment slot="content">
        <p class="text-base text-left">Fondo Verde, además pone a disposición de los alumnos su web, como canal de difusión de aquellos documentos que ya han pasado alguna etapa de certificación, y por tanto son admitidos para difusión. En términos de difusión y extensión de la investigación realizada por los alumnos del programa se puede mencionar también su participación en las siguientes revistas nacionales e internacionales:</p>
    </Fragment>
</HeroSection>