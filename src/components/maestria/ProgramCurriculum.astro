---
export interface CourseModule {
    title: string;
    hours: number;
    credits: number;
}

export interface Course {
    title: string;
    totalHours: number;
    totalCredits: number;
    modules: CourseModule[];
}

export interface Props {
    courses: Course[];
    thesisProject?: {
        title: string;
        hours: number;
        credits: number;
    };
}

const { 
    courses, 
    thesisProject = { title: 'Proyecto Terminal de Maestría - PTM', hours: 864, credits: 54 } 
} = Astro.props;

// Cálculo automático del periodo de formación
const formationHours = courses.reduce((acc, course) => acc + course.totalHours, 0);
const formationCredits = courses.reduce((acc, course) => acc + course.totalCredits, 0);

// Total General
const totalHours = formationHours + thesisProject.hours;
const totalCredits = formationCredits + thesisProject.credits;
---

<div class="mt-8">    
    <p class="text-base text-left mb-6">El <strong>plan de estudios</strong> del programa de maestría se precisa a continuación:</p> 
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 text-left items-stretch">
        {
            courses.map((course) => (
            <div class="bg-white dark:bg-slate-900 shadow-md rounded-lg overflow-hidden border border-gray-200 dark:border-gray-700 flex flex-col h-full group">
                <div class="bg-slate-800 dark:bg-slate-700 text-white px-4 py-3 flex justify-between items-center font-bold min-h-[5.5rem] lg:min-h-[5rem] group-hover:bg-primary transition-colors duration-300">
                <h3 class="text-sm md:text-base mr-2 items-center flex">
                    {course.title}
                </h3>
                <div class="text-xs md:text-sm flex space-x-3 shrink-0 tabular-nums">
                    <span>{course.totalHours} horas</span>
                    <span>{course.totalCredits} C</span>
                </div>
                </div>
                <div class="divide-y divide-gray-200 dark:divide-gray-700 text-base text-gray-700 dark:text-gray-300 tabular-nums flex-grow">
                {course.modules.map((module, index) => (
                    <div class="flex justify-between px-4 py-3 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                    <span class="mr-4">
                        <span class="font-bold text-primary">Módulo {index + 1}:</span> {module.title}
                    </span>
                    <div class="flex justify-end space-x-4 shrink-0 min-w-[100px]">
                        <span>{module.hours} horas</span>
                        <span>{module.credits} C</span>
                    </div>
                    </div>
                ))}
                </div>
            </div>
            ))
        }
    </div>

    <!-- Resumen Total Automático -->
    <div class="bg-primary/10 dark:bg-primary/20 rounded-lg overflow-hidden border border-primary/20 flex flex-col group w-full mt-8">
        <div class="px-6 py-5 text-sm md:text-base text-gray-800 dark:text-gray-200 w-full space-y-2">
            <div class="flex flex-col sm:flex-row justify-between w-full lg:w-3/4 xl:w-2/3">
                <span class="font-bold text-left mb-1 sm:mb-0">Periodo de Formación (áreas centrales)</span>
                <div class="flex justify-between sm:justify-end sm:space-x-8 w-full sm:w-auto">
                    <span class="sm:w-32 text-right">{formationHours} horas</span>
                    <span class="sm:w-32 text-right">{formationCredits} Créditos</span>
                </div>
            </div>
            <div class="flex flex-col sm:flex-row justify-between w-full lg:w-3/4 xl:w-2/3">
                <span class="font-bold text-left mb-1 sm:mb-0">{thesisProject.title}</span>
                <div class="flex justify-between sm:justify-end sm:space-x-8 w-full sm:w-auto">
                    <span class="sm:w-32 text-right">{thesisProject.hours} horas</span>
                    <span class="sm:w-32 text-right">{thesisProject.credits} Créditos</span>
                </div>
            </div>
            
            <!-- Separador -->
            <div class="border-t border-primary/30 my-2 w-full lg:w-3/4 xl:w-2/3"></div>
            
            <div class="flex flex-col sm:flex-row justify-between w-full lg:w-3/4 xl:w-2/3 text-primary font-bold text-lg">
                <span class="mb-1 sm:mb-0">TOTAL DEL PROGRAMA</span>
                <div class="flex justify-between sm:justify-end sm:space-x-8 w-full sm:w-auto">
                    <span class="sm:w-32 text-right">{totalHours} horas</span>
                    <span class="sm:w-32 text-right">{totalCredits} Créditos</span>
                </div>
            </div>
        </div>
    </div>
    <div class="flex justify-end w-full lg:col-span-2">
        <p class="text-red-600 dark:text-red-400 text-sm italic mt-1 text-right">*Este programa académico puede experimentar modificaciones</p>
    </div>
</div>
