---
import Content from '~/components/widgets/Content.astro';
---

<Content
    id="claustro"
    tagline="Claustro"
    title="Claustro Académico"
    items={[
        {
        title: 'Excelencia Académica y Profesional',
        description:
            'Nuestro staff está integrado por docentes universitarios, investigadores y profesionales en activo de la administración pública y la empresa privada, garantizando una formación rigurosa y aplicada a la realidad del sector.',
        icon: 'tabler:school',
        },
        {
        title: 'Expertos Multidisciplinares',
        description:
            'Colaboramos con especialistas de primer nivel provenientes de diversos organismos e instituciones internacionales, profundamente involucrados en las áreas clave de sostenibilidad y responsabilidad social.',
        icon: 'tabler:users-group',
        },
    ]}
    image={{
        src: '~/assets/images/fvi-profesorado-tutoria.webp',
        alt: 'Imagen del profesorado del Doctorado de Fondo Verde',
    }}
    >
    <Fragment slot="bg">
        <div class="absolute inset-0 bg-blue-50 dark:bg-pageDark"></div>
    </Fragment>
</Content>
