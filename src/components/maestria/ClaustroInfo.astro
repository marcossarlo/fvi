---
import Content from '~/components/widgets/Content.astro';
---

<Content
    id="claustro"
    tagline="Claustro"
    title="Claustro Académico"
    items={[
        {
        title: 'Staff académico especializado',
        description:
            'El programa, cuenta con un staff de alto nivel académico, especializado en cada una de las materias de conocimiento y configurado por personal universitario docente e investigador y por profesionales en activo en la administración pública y en la empresa privada.',
        icon: 'tabler:school',
        },
        {
        title: 'Participación de profesionales externo',
        description:
            'Además, participan profesionales de primer nivel de otras empresas, organismos oficiales e instituciones, todos ellos directamente implicados en las diferentes áreas de conocimiento abarcadas en esta Maestría.',
        icon: 'tabler:users-group',
        },
    ]}
    image={{
        src: '~/assets/images/fvi-profesorado-tutoria.jpg',
        alt: 'Imagen del profesorado del Doctorado de Fondo Verde',
    }}
    >
    <Fragment slot="bg">
        <div class="absolute inset-0 bg-blue-50 dark:bg-pageDark"></div>
    </Fragment>
</Content>
