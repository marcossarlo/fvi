---
export interface Props {
  tabs: ReadonlyArray<{ id: string; label: string }>;
}

const { tabs } = Astro.props;
const getTabLabel = (label: string) => label.replace(/^\d+\.\s*/, '');
---

<div class="relative h-full w-full" id="program-toc">
  <aside
    id="desktop-sidebar"
    class="fixed left-0 top-[76px] z-40 hidden h-[calc(100vh-76px)] w-64 -translate-x-full flex-col overflow-y-auto border-r border-teal-500/50 bg-accent text-white opacity-90 shadow-[4px_0_24px_rgba(13,148,136,0.2)] backdrop-blur-xl transition-all duration-700 ease-out custom-scrollbar dark:border-teal-500/50 dark:bg-accent dark:text-white 2xl:w-72 lg:flex"
  >
    <div id="desktop-sidebar-inner" class="flex h-full flex-col p-6">
      <div class="mb-6 flex shrink-0 items-center justify-between gap-3 text-white dark:text-white">
        <span id="desktop-sidebar-title" class="whitespace-nowrap text-sm font-bold uppercase tracking-tight"
          >Explorar programa</span
        >
        <button
          id="desktop-sidebar-toggle"
          type="button"
          class="group/chevron flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-teal-400 bg-teal-400 text-white transition-all hover:scale-110 hover:border-teal-300 hover:bg-teal-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-300"
          aria-label="Contraer navegación del programa"
          aria-expanded="true"
        >
          <svg
            id="desktop-sidebar-toggle-icon"
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5 transition-transform duration-300 group-hover/chevron:-translate-x-0.5 group-hover/chevron:rotate-12"
            viewBox="0 0 24 24"
            stroke-width="2.5"
            stroke="currentColor"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M15 6l-6 6l6 6"></path>
          </svg>
        </button>
      </div>

      <nav aria-label="Secciones del programa" class="flex-grow">
        <ul class="relative space-y-1" id="desktop-toc-list">
          <span
            id="desktop-toc-line"
            class="pointer-events-none absolute bottom-4 left-3 top-4 w-px bg-white/20 dark:bg-slate-300"></span>
          {
            tabs.map((tab, index) => (
              <li class="group relative z-10">
                <a
                  href={`#${tab.id}`}
                  class="toc-link flex items-start py-2.5 text-sm text-white/70 transition-colors duration-300 hover:text-white"
                  data-target={tab.id}
                >
                  <span class="mr-3 mt-1 flex w-6 items-center justify-center">
                    <span class="toc-indicator h-3 w-3 rounded-full border-2 border-white/60 bg-teal-400 transition-all duration-300 group-hover:scale-125 group-hover:border-white" />
                  </span>
                  <span class="toc-label font-medium leading-tight transition-transform duration-300 group-hover:-translate-y-px">
                    {getTabLabel(tab.label)}
                  </span>
                  <span class="toc-index absolute -top-2 left-0 font-mono text-[0.7rem] font-bold text-white opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100">
                    {(index + 1).toString().padStart(2, '0')}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="mt-8 flex justify-center border-t border-white/20 pt-6">
        <a
          id="desktop-sidebar-cta"
          href="#solicitudes"
          aria-label="Solicitar información"
          class="group/chevron flex h-9 w-full items-center justify-center gap-2 rounded-lg border border-transparent bg-white px-4 py-2 text-sm font-medium text-teal-600 shadow-md shadow-black/10 transition-all hover:!border-teal-400 hover:!bg-teal-400 hover:!text-white active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-300"
        >
          <svg
            id="desktop-sidebar-cta-icon"
            xmlns="http://www.w3.org/2000/svg"
            class="hidden h-5 w-5 shrink-0 transition-transform duration-300 group-hover/chevron:-translate-x-0.5 group-hover/chevron:rotate-12"
            viewBox="0 0 24 24"
            stroke-width="2.5"
            stroke="currentColor"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 5h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z"></path>
            <path d="m3 7 9 6 9-6"></path>
          </svg>
          <span id="desktop-sidebar-cta-label">Solicitar información</span>
        </a>
      </div>
    </div>
  </aside>

  <div
    id="desktop-sidebar-tooltip"
    class="pointer-events-none fixed z-[60] hidden text-xs font-medium text-[#343434] dark:text-white"
  >
    <span id="desktop-sidebar-tooltip-index" class="absolute -top-5 left-0 font-mono font-normal text-white"></span>
    <span
      id="desktop-sidebar-tooltip-label"
      class="absolute left-6 top-1 whitespace-nowrap rounded bg-slate-800 px-2 py-1 text-xs font-normal text-white shadow-md"
    ></span>
  </div>

  <div
    id="mobile-bottom-sheet"
    class="fixed bottom-6 left-1/2 z-50 w-[92%] max-w-sm -translate-x-1/2 translate-y-full opacity-0 transition-all duration-700 ease-[cubic-bezier(0.34,1.56,0.64,1)] sm:max-w-md lg:hidden"
  >
    <div
      class="flex flex-col overflow-hidden rounded-2xl border border-white/20 bg-accent shadow-2xl shadow-[rgba(13,148,136,0.4)] backdrop-blur-xl dark:border-slate-800/80 dark:bg-slate-900/95"
    >
      <button
        id="mobile-toc-toggle"
        type="button"
        class="group flex w-full items-center justify-between rounded-t-2xl px-5 py-3.5 text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-white dark:text-white"
        aria-expanded="false"
        aria-controls="mobile-toc-menu"
      >
        <span class="flex items-center space-x-3 overflow-hidden">
          <span
            class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white/20 text-white dark:bg-emerald-500/20 dark:text-emerald-400"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke="currentColor"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 6l16 0"></path>
              <path d="M4 12l16 0"></path>
              <path d="M4 18l16 0"></path>
            </svg>
          </span>
          <span class="flex min-w-0 flex-col items-start truncate">
            <span class="text-[0.65rem] font-semibold uppercase tracking-wider text-white/70 dark:text-slate-400"
              >Estás en</span
            >
            <span class="truncate text-sm font-bold text-white dark:text-emerald-400" id="mobile-toc-current"
              >Presentación</span
            >
          </span>
        </span>
        <span
          class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white/10 text-white transition-colors group-hover:bg-white/20 dark:bg-white/10 dark:text-white dark:group-hover:bg-white/20"
        >
          <svg
            id="mobile-toc-chevron"
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 transition-transform duration-300"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M6 9l6 6l6 -6"></path>
          </svg>
        </span>
      </button>

      <div id="mobile-toc-menu" class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out">
        <div class="overflow-hidden">
          <div
            class="max-h-[50vh] overflow-y-auto overscroll-contain border-t border-white/10 px-3 pb-3 pt-2 custom-scrollbar-mobile dark:border-teal-200/50"
          >
            <ul class="space-y-1">
              {
                tabs.map((tab, index) => (
                  <li>
                    <a
                      href={`#${tab.id}`}
                      class="toc-link flex items-center rounded-xl px-4 py-3 text-sm text-white/80 transition-all hover:bg-white/10 hover:text-white active:scale-[0.98] dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-emerald-500"
                      data-target={tab.id}
                    >
                      <span class="w-6 font-mono text-xs text-white/50 opacity-60 dark:text-slate-500">
                        {(index + 1).toString().padStart(2, '0')}
                      </span>
                      <span class="truncate font-medium">{getTabLabel(tab.label)}</span>
                      <span class="mobile-check ml-auto scale-50 text-white opacity-0 transition-all dark:text-emerald-500">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="h-5 w-5"
                          viewBox="0 0 24 24"
                          stroke-width="2"
                          stroke="currentColor"
                          fill="none"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="M5 12l5 5l10 -10" />
                        </svg>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  type Cleanup = () => void;

  let cleanupTOC: Cleanup | undefined;

  const initTOC = () => {
    cleanupTOC?.();

    const root = document.getElementById('program-toc');
    if (!root) return;

    const getElement = <T extends Element>(id: string) => document.getElementById(id) as T | null;
    const tocLinks = Array.from(root.querySelectorAll<HTMLAnchorElement>('.toc-link'));
    if (!tocLinks.length) return;

    const sections = Array.from(
      new Set(
        tocLinks
          .map((link) => link.dataset.target)
          .filter((target): target is string => Boolean(target))
          .map((target) => document.getElementById(target))
          .filter((section): section is HTMLElement => Boolean(section))
      )
    );
    const presentationSection = getElement<HTMLElement>('presentacion') ?? sections[0];
    const requestsSection = getElement<HTMLElement>('solicitudes');
    const programContent = document.querySelector<HTMLElement>('[data-program-content]');
    const mobileToggle = getElement<HTMLButtonElement>('mobile-toc-toggle');
    const mobileMenu = getElement<HTMLElement>('mobile-toc-menu');
    const mobileChevron = getElement<SVGElement>('mobile-toc-chevron');
    const mobileCurrent = getElement<HTMLElement>('mobile-toc-current');
    const mobileBottomSheet = getElement<HTMLElement>('mobile-bottom-sheet');
    const desktopSidebar = getElement<HTMLElement>('desktop-sidebar');
    const desktopSidebarInner = getElement<HTMLElement>('desktop-sidebar-inner');
    const desktopSidebarToggle = getElement<HTMLButtonElement>('desktop-sidebar-toggle');
    const desktopSidebarToggleIcon = getElement<SVGElement>('desktop-sidebar-toggle-icon');
    const desktopSidebarTitle = getElement<HTMLElement>('desktop-sidebar-title');
    const desktopSidebarCta = getElement<HTMLAnchorElement>('desktop-sidebar-cta');
    const desktopSidebarCtaIcon = getElement<SVGElement>('desktop-sidebar-cta-icon');
    const desktopSidebarCtaLabel = getElement<HTMLElement>('desktop-sidebar-cta-label');
    const desktopTocLine = getElement<HTMLElement>('desktop-toc-line');
    const sidebarTooltip = getElement<HTMLElement>('desktop-sidebar-tooltip');
    const sidebarTooltipIndex = getElement<HTMLElement>('desktop-sidebar-tooltip-index');
    const sidebarTooltipLabel = getElement<HTMLElement>('desktop-sidebar-tooltip-label');
    const tocLabels = Array.from(root.querySelectorAll<HTMLElement>('.toc-label'));
    const tocIndexes = Array.from(root.querySelectorAll<HTMLElement>('.toc-index'));

    let isMenuOpen = false;
    let isSidebarCollapsed = false;
    let hasScrolledToFirstSection = false;
    const cleanups: Cleanup[] = [];
    const listen = <K extends keyof WindowEventMap>(
      target: Window | HTMLElement | HTMLAnchorElement | HTMLButtonElement,
      event: K,
      handler: (event: WindowEventMap[K]) => void,
      options?: AddEventListenerOptions
    ) => {
      target.addEventListener(event, handler as EventListener, options);
      cleanups.push(() => target.removeEventListener(event, handler as EventListener, options));
    };

    const setContentOffset = () => {
      if (!programContent) return;

      const desktopOffset =
        hasScrolledToFirstSection && window.innerWidth >= 1024
          ? isSidebarCollapsed
            ? '4rem'
            : window.innerWidth >= 1536
              ? '18rem'
              : '16rem'
          : '0px';

      programContent.style.setProperty('margin-left', desktopOffset, 'important');
    };

    const setMobileMenuOpen = (open: boolean) => {
      if (!mobileMenu || !mobileChevron || !mobileToggle) return;

      isMenuOpen = open;
      mobileMenu.classList.toggle('grid-rows-[1fr]', open);
      mobileMenu.classList.toggle('grid-rows-[0fr]', !open);
      mobileChevron.classList.toggle('rotate-180', open);
      mobileToggle.setAttribute('aria-expanded', String(open));
    };

    const setSidebarCollapsed = (collapsed: boolean) => {
      if (!desktopSidebar || !desktopSidebarInner || !desktopSidebarToggle || !desktopSidebarToggleIcon) return;

      isSidebarCollapsed = collapsed;
      desktopSidebar.classList.toggle('w-16', collapsed);
      desktopSidebar.classList.toggle('w-64', !collapsed);
      desktopSidebar.classList.toggle('2xl:w-72', !collapsed);
      desktopSidebarInner.classList.toggle('p-3', collapsed);
      desktopSidebarInner.classList.toggle('p-6', !collapsed);
      desktopSidebarTitle?.classList.toggle('hidden', collapsed);
      desktopSidebarCta?.classList.toggle('w-9', collapsed);
      desktopSidebarCta?.classList.toggle('w-full', !collapsed);
      desktopSidebarCta?.classList.toggle('rounded-md', collapsed);
      desktopSidebarCta?.classList.toggle('rounded-lg', !collapsed);
      desktopSidebarCta?.classList.toggle('hover:scale-110', collapsed);
      desktopSidebarCta?.classList.toggle('px-0', collapsed);
      desktopSidebarCta?.classList.toggle('gap-2', !collapsed);
      desktopSidebarCtaIcon?.classList.toggle('hidden', !collapsed);
      desktopSidebarCtaLabel?.classList.toggle('hidden', collapsed);
      tocLabels.forEach((label) => label.classList.toggle('hidden', collapsed));
      tocIndexes.forEach((index) => index.classList.toggle('hidden', collapsed));
      tocLinks.forEach((link) => {
        link.classList.toggle('justify-center', collapsed);
        link.querySelector('.toc-indicator')?.classList.toggle('mr-3', !collapsed);
      });
      desktopTocLine?.classList.toggle('left-3', !collapsed);
      desktopTocLine?.classList.toggle('left-1/2', collapsed);
      desktopTocLine?.classList.toggle('-translate-x-1/2', collapsed);
      desktopSidebarToggle.setAttribute('aria-expanded', String(!collapsed));
      desktopSidebarToggle.setAttribute(
        'aria-label',
        collapsed ? 'Expandir navegación del programa' : 'Contraer navegación del programa'
      );
      desktopSidebarToggleIcon.classList.toggle('rotate-180', collapsed);
    };

    const showSidebarTooltip = (link: HTMLAnchorElement, index: number) => {
      if (!isSidebarCollapsed || !sidebarTooltip || !sidebarTooltipIndex || !sidebarTooltipLabel) return;

      const indicator = link.querySelector<HTMLElement>('.toc-indicator');
      if (!indicator) return;

      const { left, top } = indicator.getBoundingClientRect();
      sidebarTooltipIndex.textContent = (index + 1).toString().padStart(2, '0');
      sidebarTooltipLabel.textContent = link.querySelector('.toc-label')?.textContent?.trim() ?? '';
      sidebarTooltip.style.left = `${left}px`;
      sidebarTooltip.style.top = `${top}px`;
      sidebarTooltip.classList.remove('hidden');
    };

    const updateActiveState = (activeId: string) => {
      tocLinks.forEach((link) => {
        const isActive = link.dataset.target === activeId;
        link.classList.toggle('active-desktop', isActive);
        link.classList.toggle('active-mobile', isActive);
        if (!isActive) return;

        if (window.innerWidth >= 1024) {
          const parentNav = link.closest('nav');
          const linkRect = link.getBoundingClientRect();
          const navRect = parentNav?.getBoundingClientRect();
          if (navRect && (linkRect.top < navRect.top || linkRect.bottom > navRect.bottom)) {
            link.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        }

        if (mobileCurrent) {
          mobileCurrent.textContent = link.querySelector('.font-medium')?.textContent?.trim() ?? '';
        }
      });
    };

    const revealTOC = () => {
      if (hasScrolledToFirstSection) return;
      hasScrolledToFirstSection = true;
      setContentOffset();
      desktopSidebar?.classList.remove('opacity-0', '-translate-x-full');
      mobileBottomSheet?.classList.remove('opacity-0', 'translate-y-full');
    };

    const hideTOC = () => {
      hasScrolledToFirstSection = false;
      setContentOffset();
      desktopSidebar?.classList.add('opacity-0', '-translate-x-full');
      mobileBottomSheet?.classList.add('opacity-0', 'translate-y-full');
    };

    const checkScrollPosition = () => {
      if (!presentationSection) return;

      const presentationTop = presentationSection.getBoundingClientRect().top;
      const requestsTop = requestsSection?.getBoundingClientRect().top;
      const isWithinProgram =
        presentationTop <= window.innerHeight * 0.2 &&
        (requestsTop === undefined || requestsTop > window.innerHeight * 0.6);

      if (isWithinProgram) revealTOC();
      else hideTOC();
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.filter((entry) => entry.isIntersecting).forEach((entry) => updateActiveState(entry.target.id));
      },
      { rootMargin: '-15% 0px -75% 0px', threshold: 0 }
    );

    sections.forEach((section) => observer.observe(section));
    cleanups.push(() => observer.disconnect());

    if (desktopSidebarToggle) {
      listen(desktopSidebarToggle, 'click', () => {
        setSidebarCollapsed(!isSidebarCollapsed);
        setContentOffset();
      });
    }

    tocLinks.forEach((link, index) => {
      listen(link, 'mouseenter', () => showSidebarTooltip(link, index));
      listen(link, 'mouseleave', () => sidebarTooltip?.classList.add('hidden'));
      listen(link, 'click', () => {
        if (window.innerWidth < 1024) setMobileMenuOpen(false);
      });
    });

    if (mobileToggle) {
      listen(mobileToggle, 'click', (event) => {
        event.preventDefault();
        setMobileMenuOpen(!isMenuOpen);
      });
    }

    listen(window, 'resize', setContentOffset);
    listen(window, 'scroll', checkScrollPosition, { passive: true });

    setContentOffset();
    checkScrollPosition();

    let currentActiveId = sections[0]?.id;
    let closestTop = Infinity;
    sections.forEach((section) => {
      const top = section.getBoundingClientRect().top;
      if (top >= 0 && top < closestTop) {
        closestTop = top;
        currentActiveId = section.id;
      }
    });
    if (currentActiveId) updateActiveState(currentActiveId);

    cleanupTOC = () => {
      cleanups.splice(0).forEach((cleanup) => cleanup());
      sidebarTooltip?.classList.add('hidden');
    };
  };

  initTOC();
  document.addEventListener('astro:after-swap', initTOC);
</script>
